# Production environment (BACKEND on VPS) — copy to .env.prod and fill in real values.
# NEVER commit .env.prod to git.
#
# NOTE: the frontend lives on Cloudflare Pages. Its API URL is set there as
# the NEXT_PUBLIC_API_URL environment variable (see DEPLOY.md Part B).

# --- Database ---
POSTGRES_USER=coworking
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=coworking
TZ=Asia/Karachi

# --- API secrets (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Cloudflare Tunnel token (only if using the tunnel service) ---
# TUNNEL_TOKEN=
