# Copy to .env and fill in
DATABASE_URL="postgresql://coworking:coworking@localhost:5432/coworking?schema=public"
PORT=4000
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
# TOTP secret encryption (AES-256-GCM) — REQUIRED in production.
# 64 hex chars (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=""
# Optional WhatsApp/SMS provider (leave empty to use console-log fallback)
WHATSAPP_PROVIDER=""
WHATSAPP_API_KEY=""

# Google Calendar Sync (Phase 36) — Google Cloud Console se OAuth2 credentials.
# Redirect URI bilkul yehi hona chahiye (Authorized redirect URIs me add karo).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="https://techub-api.150.230.52.29.sslip.io/api/calendar/callback"
# Optional: OAuth callback ke baad frontend redirect (default: /settings/calendar)
FRONTEND_URL="https://techub-co-working.pages.dev"
