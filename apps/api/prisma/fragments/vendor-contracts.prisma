// Phase 41 Track 9: Vendor Contract Expiry Tracking — schema fragment.
//
// COORDINATOR: merge into schema.prisma + back-relations jodein:
//   Tenant { vendorContracts VendorContract[] }
//   Vendor { contracts VendorContract[] }   (Track 1 ke Vendor model par)
// schema.prisma untouched by this track.

model VendorContract {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorId        String   @map("vendor_id")
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  title           String
  startDate       DateTime? @map("start_date")
  endDate         DateTime @map("end_date")
  value           Decimal? @db.Decimal(12, 2)
  autoRenew       Boolean  @default(false) @map("auto_renew")
  documentUrl     String?  @map("document_url")
  reminderDays    Int      @default(30) @map("reminder_days") // endDate se pehle kitne din par remind ho
  status          String   @default("active") @map("status") // active | expired
  lastReminderKey String?  @map("last_reminder_key") // dedupe: "<endDateISO>:<days>" ya "...:expired"

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, endDate])
  @@map("vendor_contracts")
}

