model EmailTemplate {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String   // e.g. 'bookingConfirmed' — matches mailer's notify() template names
  subject   String
  htmlBody  String   @map("html_body") @db.Text
  variables Json     @default("[]") // available {{variable}} names (documented in editor)
  isCustom  Boolean  @default(false) @map("is_custom") // false = seeded default, true = user-edited
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("email_templates")
}

