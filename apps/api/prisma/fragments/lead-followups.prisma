model LeadFollowup {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId     String   @map("lead_id")
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dueAt      DateTime @map("due_at")
  type       String   // call | email | whatsapp | tour
  note       String?  @db.Text
  status     String   @default("pending") // pending | done | skipped
  assignedTo String?  @map("assigned_to")
  assignee   User?    @relation("LeadFollowupAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([tenantId, status, dueAt])
  @@index([tenantId, assignedTo, status])
  @@index([leadId])
  @@map("lead_followups")
}

