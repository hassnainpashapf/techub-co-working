// Phase 56 Track 4: Locker Access Codes (PINs — Phase 48 smart-lock pattern).
// COORDINATOR: merge into schema.prisma + add back-relations:
//   Tenant { lockerCodes LockerCode[] }
//   Locker { codes LockerCode[] }
// NOTE: Locker model Track 1 (lockers.prisma) se aata hai — usay PEHLE merge karein.
// schema.prisma untouched by this track.

model LockerCode {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  lockerId  String    @map("locker_id")
  codeHash  String    @map("code_hash") // bcrypt hash — plain PIN kabhi store nahi (Phase 48 pattern)
  isActive  Boolean   @default(true) @map("is_active")
  issuedAt  DateTime  @default(now()) @map("issued_at")
  expiresAt DateTime? @map("expires_at")
  issuedBy  String?   @map("issued_by") // User id jis ne issue kiya
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locker Locker @relation(fields: [lockerId], references: [id], onDelete: Cascade)

  @@unique([lockerId]) // ek locker par ek record (rotate = purani deactivate + replace)
  @@index([tenantId])
  @@map("locker_codes")
}

