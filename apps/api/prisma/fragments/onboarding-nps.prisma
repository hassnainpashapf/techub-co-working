// Phase 54 Track 6: 30-Day Feedback Auto-NPS
// COORDINATOR: merge into schema.prisma + add back-relations:
//   Tenant { onboardingFeedback OnboardingFeedback[] }
//   Member { onboardingFeedback OnboardingFeedback? }
// schema.prisma untouched by this track.

model OnboardingFeedback {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  memberId    String   @map("member_id")
  score       Int // 0..10 (NPS)
  comment     String?
  submittedAt DateTime @default(now()) @map("submitted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tenantId, memberId]) // ek member ek dafa feedback deta hai
  @@index([tenantId, submittedAt])
  @@map("onboarding_feedback")
}

