// Phase 43 Track 8: Kitchen Staff & Shifts for Cafe.
// Alag model (Employee.department constrained hai: ops/finance/sales/admin/support)
// is liye cafe role ko separate table me rakha — department untouched.
model CafeStaff {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String   @unique @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       String   // chef | cashier | runner
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, isActive])
  @@index([tenantId, role])
  @@map("cafe_staff")
}

