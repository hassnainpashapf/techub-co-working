// Phase 55 Track 3: Concierge Service Providers
// COORDINATOR: merge into schema.prisma + add back-relations:
//   Tenant { serviceProviders ServiceProvider[] }
// schema.prisma untouched by this track.

model ServiceProvider {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  category    String   // errand | food | transport | wellness | business | home | other
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  address     String?
  ratingAvg   Float?   @map("rating_avg") // 0..5, computed from provider ratings
  ratingCount Int      @default(0) @map("rating_count")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category])
  @@index([tenantId, isActive])
  @@map("service_providers")
}

