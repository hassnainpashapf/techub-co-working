// DELTA — EventTicket model (Track 3) par 2 naye fields:
model EventTicket {
  // ... (Track 3 ke fields)
  refundReason String?   @map("refund_reason") // staff ne kyun refund kiya
  refundedAt   DateTime? @map("refunded_at")

  transfers TicketTransfer[] // meray transfer records (ticket as source)
}

model TicketTransfer {
  id            String       @id @default(cuid())
  tenantId      String       @map("tenant_id")
  ticketId      String       @map("ticket_id") // purana (invalidate hua) ticket
  ticket        EventTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromEmail     String       @map("from_email")
  toName        String       @map("to_name")
  toEmail       String       @map("to_email")
  transferredAt DateTime     @default(now()) @map("transferred_at")

  @@index([tenantId, ticketId])
  @@index([toEmail])
  @@map("ticket_transfers")
}

