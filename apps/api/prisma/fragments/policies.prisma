model Policy {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  category      String   @default("general")
  fileUrl       String?
  body          String?  @db.Text
  version       Int      @default(1)
  effectiveDate DateTime?
  requiresAck   Boolean  @default(true)
  reAckOnUpdate Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  acks          PolicyAck[]

  @@index([tenantId, isActive])
  @@map("Policy")
}

model PolicyAck {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policyId String
  policy   Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  memberId String?
  member   Member?  @relation("MemberPolicyAcks", fields: [memberId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?    @relation("UserPolicyAcks", fields: [userId], references: [id], onDelete: Cascade)
  ackedAt  DateTime @default(now())
  ipHash   String?

  @@unique([policyId, memberId])
  @@unique([policyId, userId])
  @@index([tenantId, policyId])
  @@map("PolicyAck")
}
