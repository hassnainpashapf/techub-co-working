// Phase 38 Track 9: Feedback & Suggestions Box — schema EXTENSION.
// (Phase 29 Track 8 created the Feedback model; this extends it.)
// Coordinator: merge these ADDITIVE changes into apps/api/prisma/schema.prisma
// and create the matching migration. DO NOT edit schema.prisma here.
//
// Changes to existing Feedback model:
//   - memberId -> optional (anonymous feedback), member -> Member?
//   - ADD title String?
//   - RENAME message -> body (@db.Text)
//   - ADD isAnonymous Boolean @default(false)
//   - ADD upvotes Int @default(0)
//   - ADD upvotedBy FeedbackUpvote[]
//   - categories extended: suggestion | complaint | praise | facility | service | staff | cleanliness | other
//   - statuses extended: new | reviewed | planned | done | rejected | resolved
// New model: FeedbackUpvote (one upvote per member per feedback)

model FeedbackUpvote {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feedbackId String   @map("feedback_id")
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  memberId   String   @map("member_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([feedbackId, memberId])
  @@index([tenantId])
  @@map("feedback_upvotes")
}

