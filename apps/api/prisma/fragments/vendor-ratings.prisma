// Phase 41 Track 8: Vendor Performance Ratings
// COORDINATOR: merge into schema.prisma + add back-relations:
//   Vendor { ratings VendorRating[] }   (relation name "VendorRatings")
//   User   { vendorRatings VendorRating[] } (relation name "UserVendorRatings")
//   Tenant { vendorRatings VendorRating[] } (relation name "TenantVendorRatings")
// schema.prisma untouched by this track.

model VendorRating {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation("TenantVendorRatings", fields: [tenantId], references: [id], onDelete: Cascade)
  vendorId  String   @map("vendor_id")
  vendor    Vendor   @relation("VendorRatings", fields: [vendorId], references: [id], onDelete: Cascade)
  ratedBy   String   @map("rated_by")
  rater     User     @relation("UserVendorRatings", fields: [ratedBy], references: [id], onDelete: Cascade)
  score     Int      // 1-5
  // quality | timeliness | price
  criteria  String   @default("quality")
  comment   String?  @db.Text
  ratedAt   DateTime @default(now()) @map("rated_at")
  createdAt DateTime @default(now()) @map("created_at")

  // ek user ek vendor ko ek dafa rate kare — dobara rate = update
  @@unique([vendorId, ratedBy])
  @@index([tenantId, vendorId])
  @@map("vendor_ratings")
}

