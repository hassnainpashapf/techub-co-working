// Phase 47 Track 2/10: Public Form Rendering + Submissions — FormSubmission model.
// Coordinator: schema.prisma me merge karo + back-relations joro:
//   Tenant:  formSubmissions FormSubmission[]
//   CustomForm: submissions (pehle se forms.prisma fragment me hai)
//   Member:  formSubmissions FormSubmission[]
model FormSubmission {
  id             String    @id @default(cuid())
  tenantId       String
  formId         String
  form           CustomForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers        Json      // {fieldId: value} — file fields: [{name, size, mime, dataUrl}]
  submitterName  String?
  submitterEmail String?
  memberId       String?
  member         Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  ipHash         String?   // sha256(ip + tenant salt) — privacy-safe
  createdAt      DateTime  @default(now())

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, formId])
  @@index([formId, createdAt])
  @@index([tenantId, submitterEmail])
}

