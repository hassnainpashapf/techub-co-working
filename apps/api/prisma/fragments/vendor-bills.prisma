// Phase 41 Track 4: Vendor Bills — supplier invoices against POs/GRNs,
// with 3-way match (PO <-> GRN <-> Bill) and auto expense creation on approve.
//
// COORDINATOR: merge into schema.prisma + add back-relations:
//   Tenant        { vendorBills VendorBill[] }
//   Vendor        { vendorBills VendorBill[] }
//   PurchaseOrder { vendorBills VendorBill[] }
//   GoodsReceipt  { vendorBills VendorBill[] }
//   User          { vendorBillApprovals VendorBill[] @relation("VendorBillApprover") }
// NOTE: `overdue` is derived (dueDate < today && status in pending/approved),
// not a stored status — same as quotations' pastDue pattern.
// schema.prisma untouched by this track.

model VendorBill {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billNo        String         @map("bill_no") // vendor ka apna invoice number
  vendorId      String         @map("vendor_id")
  vendor        Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  poId          String?        @map("po_id")
  purchaseOrder PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  grnId         String?        @map("grn_id")
  goodsReceipt  GoodsReceipt?  @relation(fields: [grnId], references: [id], onDelete: SetNull)
  amount        Decimal        @db.Decimal(12, 2)
  dueDate       DateTime       @db.Date @map("due_date")
  status        String         @default("pending") @map("status") // pending | approved | paid | disputed
  disputeReason String?        @map("dispute_reason") @db.Text
  paidAt        DateTime?      @map("paid_at")
  expenseId     String?        @map("expense_id") // approve par bani Expense entry ka id (no FK)
  approvedBy    String?        @map("approved_by")
  approver      User?          @relation("VendorBillApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  notes         String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, vendorId])
  @@index([tenantId, dueDate])
  @@map("vendor_bills")
}

