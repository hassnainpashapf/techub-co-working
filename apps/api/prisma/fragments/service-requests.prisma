// Phase 55 Track 2: Service Requests
// COORDINATOR: merge into schema.prisma + add back-relations:
//   Tenant { serviceRequests ServiceRequest[] }
//   Member { serviceRequests ServiceRequest[] }
//   ConciergeService { requests ServiceRequest[] }
//   User { assignedServiceRequests ServiceRequest[] }  (named relation "ServiceRequestAssignee")
// NOTE: ConciergeService model Track 1 (concierge-services.prisma) se aata hai — usay PEHLE merge karein.
// schema.prisma untouched by this track.

model ServiceRequest {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  memberId    String   @map("member_id")
  serviceId   String?  @map("service_id")
  title       String
  details     String?
  status      String   @default("new") // new | accepted | in_progress | done | cancelled
  priority    String   @default("normal") // low | normal | high | urgent
  assignedTo  String?  @map("assigned_to")
  price       Decimal? @db.Decimal(12, 2)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member   Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  service  ConciergeService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  assignee User?            @relation("ServiceRequestAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, memberId])
  @@index([tenantId, assignedTo])
  @@map("service_requests")
}

