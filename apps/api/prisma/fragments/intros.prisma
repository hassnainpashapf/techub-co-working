// Phase 40 Track 9: Member Introductions (New Member Match)
// COORDINATOR: merge into schema.prisma + add back-relations:
//   Tenant { memberIntros MemberIntro[] }
//   Member { introsAsNew MemberIntro[] @relation("IntroNew"); introsAsSuggested MemberIntro[] @relation("IntroSuggested") }
// schema.prisma untouched by this track.

model MemberIntro {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  newMemberId       String   @map("new_member_id")
  suggestedMemberId String   @map("suggested_member_id")
  reason            String   // human-readable: "same industry: fintech" / "shared tags: design, startups"
  score             Int      @default(0) // 0-100 match strength (explainable, rule-based)
  status            String   @default("suggested") // suggested | introduced | dismissed
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  newMember       Member @relation("IntroNew", fields: [newMemberId], references: [id], onDelete: Cascade)
  suggestedMember Member @relation("IntroSuggested", fields: [suggestedMemberId], references: [id], onDelete: Cascade)

  @@unique([tenantId, newMemberId, suggestedMemberId]) // same pair dobara suggest nahi
  @@index([tenantId, status])
  @@map("member_intros")
}

