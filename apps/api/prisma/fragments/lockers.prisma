//   Tenant { lockers Locker[] }
// schema.prisma untouched by this track.

model Locker {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  code        String // unique per tenant (e.g. "L-101")
  location    String? // floor/zone description
  size        String   @default("M") // S | M | L | XL
  status      String   @default("available") // available | occupied | reserved | maintenance
  monthlyRate Decimal? @map("monthly_rate") @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, size])
  @@map("lockers")
}

