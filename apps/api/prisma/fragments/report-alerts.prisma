// Phase 52 Track 8: KPI Threshold Alerts — schema fragment.
// Coordinator merge karega: schema.prisma me ReportAlert model +
// Tenant me `reportAlerts ReportAlert[]` back-relation + CustomReport me `alerts ReportAlert[]`.

model ReportAlert {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reportId       String       @map("report_id")
  report         CustomReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name           String? // alert ka label (default: "<report> · <metricField> <op> <threshold>")
  metricField    String       @map("metric_field") // report column jiska aggregate nikle
  aggregate      String       @default("sum") @map("aggregate") // sum | count | avg
  operator       String       @map("operator") // gt | lt | eq
  threshold      Decimal      @map("threshold") @db.Decimal(14, 2)
  checkFrequency String       @default("daily") @map("check_frequency") // daily | weekly
  lastRunAt      DateTime?    @map("last_run_at")
  lastTriggeredAt DateTime?   @map("last_triggered_at")
  lastValue      Decimal?     @map("last_value") @db.Decimal(14, 2)
  isActive       Boolean      @default(true) @map("is_active")
  createdBy      String?      @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([tenantId, isActive])
  @@index([reportId])
  @@map("report_alerts")
}

