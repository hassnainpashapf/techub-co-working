// Phase 53 Track 7/10: Course Ratings & Reviews — schema fragment.
// Coordinator: merge into apps/api/prisma/schema.prisma + back-relations joro:
//   Tenant { courseRatings CourseRating[] }
//   Course { ratings CourseRating[] }
//   Member { courseRatings CourseRating[] }
// schema.prisma untouched by this track.

model CourseRating {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  courseId  String   @map("course_id")
  memberId  String   @map("member_id")
  rating    Int // 1..5
  review    String? // optional review text (max 2000)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([courseId, memberId]) // ek member ek course ko ek dafa rate karta hai (dobara = update)
  @@index([tenantId, courseId])
  @@index([tenantId, memberId])
  @@map("course_ratings")
}

