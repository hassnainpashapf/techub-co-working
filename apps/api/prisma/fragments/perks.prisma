// COORDINATOR: merge into schema.prisma + add back-relations:
//   Tenant { perks Perk[]; perkClaims PerkClaim[] }
//   Member { perkClaims PerkClaim[] }
// schema.prisma untouched by this track.

model Perk {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  partnerName String    @map("partner_name")
  title       String
  description String?
  discountText String   @map("discount_text")
  category    String    @default("other") // food | fitness | tech | travel | other
  code        String?   // redeem code shown to member on claim
  expiryDate  DateTime? @map("expiry_date")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  claims PerkClaim[]

  @@index([tenantId, isActive])
  @@map("perks")
}

model PerkClaim {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  perkId    String   @map("perk_id")
  memberId  String   @map("member_id")
  claimedAt DateTime @default(now()) @map("claimed_at")

  perk Perk @relation(fields: [perkId], references: [id], onDelete: Cascade)

  @@unique([perkId, memberId]) // ek member ek perk sirf 1 dafa claim kar sakta hai
  @@index([tenantId])
  @@index([memberId])
  @@map("perk_claims")
}

