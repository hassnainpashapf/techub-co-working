// Phase 49 Track 6: CommTemplate fragment — cross-channel message templates.
// Merge: schema.prisma me jorein + migration SQL banayein.
//   model CommTemplate { ... }
// Tenant back-relation: Tenant par `commTemplates CommTemplate[]` jorein.

model CommTemplate {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  channel    String   // any | email | sms | whatsapp | internal
  subject    String?
  body       String   @db.Text
  variables  Json?    // ["name","amount"] — body me {{name}} placeholders
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, channel])
  @@map("comm_templates")
}

