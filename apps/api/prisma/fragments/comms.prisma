// the migration (see SQL below).
//
// Channels: internal | email | sms | whatsapp | voice | note
// Directions: in | out
// Statuses: queued | sent | delivered | failed | read

model CommMessage {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel      String    // internal | email | sms | whatsapp | voice | note
  direction    String    @default("out") // in | out
  memberId     String?   @map("member_id")
  member       Member?   @relation("MemberCommMessages", fields: [memberId], references: [id], onDelete: SetNull)
  userId       String?   @map("user_id")
  user         User?     @relation("UserCommMessages", fields: [userId], references: [id], onDelete: SetNull)
  to           String?   // phone / email address for external channels
  subject      String?
  body         String    @db.Text
  status       String    @default("queued") // queued | sent | delivered | failed | read
  provider     String?   // twilio | console | meta | mailer | manual ...
  externalId   String?   @map("external_id")
  error        String?
  scheduledFor DateTime? @map("scheduled_for")
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([memberId, createdAt])
  @@index([tenantId, channel])
  @@index([tenantId, status])
  @@map("comm_messages")
}

