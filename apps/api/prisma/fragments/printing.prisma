model PrintCredit {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId      String   @map("member_id")
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  month         String   // "2026-10"
  includedPages Int      @map("included_pages")
  usedPages     Int      @default(0) @map("used_pages")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([memberId, month])
  @@index([tenantId, month])
  @@map("print_credits")
}

model PrintJob {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId  String   @map("member_id")
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pages     Int
  cost      Decimal? @db.Decimal(12, 2) // overage charge, null = covered by quota
  loggedBy  String?  @map("logged_by") // user id of staff who logged it
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, memberId])
  @@index([tenantId, createdAt])
  @@map("print_jobs")
}

