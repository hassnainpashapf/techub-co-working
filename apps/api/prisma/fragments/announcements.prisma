model Announcement {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  body      String   @db.Text
  audience  String   @default("all") // all | members | staff
  channels  String[] @default(["inapp"]) // inapp | email | sms | whatsapp
  sentBy    String   @map("sent_by")
  sender    User     @relation("SentAnnouncements", fields: [sentBy], references: [id], onDelete: Cascade)
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("announcements")
}

