model AutomationRule {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  trigger    String   // invoice_overdue | ticket_urgent_created | booking_cancelled | contract_expiring | member_inactive
  conditions Json     @default("{}") // e.g. {"minDaysOverdue":7,"minAmount":5000}
  actions    Json     @default("[]") // [{type:"create_task"|"send_email"|"notify_slack"|"assign_ticket", ...}]
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  runs       AutomationRun[]

  @@index([tenantId])
  @@map("automation_rules")
}

model AutomationRun {
  id        String         @id @default(cuid())
  tenantId  String         @map("tenant_id")
  ruleId    String         @map("rule_id")
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  trigger   String
  entityId  String?        @map("entity_id") // invoice/ticket/booking/contract/member id (dedupe)
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([ruleId])
  @@index([tenantId, trigger, createdAt])
  @@map("automation_runs")
}

