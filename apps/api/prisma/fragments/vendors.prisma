//   Tenant { vendors Vendor[] }
// schema.prisma untouched by this track.

model Vendor {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  company     String?
  email       String?
  phone       String?
  address     String?
  category    String   @default("other") // maintenance | food | it | office | other
  paymentTerms String  @default("net_30") @map("payment_terms") // net_15 | net_30 | cod
  taxId       String?  @map("tax_id")
  rating      Decimal? @db.Decimal(3, 2) // 0.00 - 5.00, Track 8 vendor performance update karega
  isActive    Boolean  @default(true) @map("is_active")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, isActive])
  @@index([tenantId, category])
  @@map("vendors")
}

