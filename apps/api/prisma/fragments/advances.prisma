//   Employee { salaryAdvances SalaryAdvance[] }
//   User     { salaryAdvancesDecided SalaryAdvance[] @relation("AdvanceDecidedBy")
//              advanceDeductionsPaidBy? (no — paidBy via User not needed; skip) }
//   PayrollRun? no relation; AdvanceDeduction.payslipId is plain String (no FK to Payslip —
//              coordinator does NOT need a back-relation on Payslip).
// schema.prisma untouched by this track.

model SalaryAdvance {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId       String    @map("employee_id")
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount           Decimal   @db.Decimal(12, 2)
  type             String    @default("advance") // advance | loan
  installments     Int       @default(1) // advance=1, loan>=2
  installmentAmount Decimal  @default(0) @map("installment_amount") @db.Decimal(12, 2)
  deductedSoFar    Decimal   @default(0) @map("deducted_so_far") @db.Decimal(12, 2)
  status           String    @default("pending") // pending | approved | rejected | deducting | closed
  reason           String?
  requestedAt      DateTime  @default(now()) @map("requested_at")
  decidedById      String?   @map("decided_by_id")
  decidedBy        User?     @relation("AdvanceDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt        DateTime? @map("decided_at")
  decideNote       String?   @map("decide_note")
  createdAt        DateTime  @default(now()) @map("created_at")

  deductions AdvanceDeduction[]

  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@map("salary_advances")
}

model AdvanceDeduction {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  advanceId   String   @map("advance_id")
  advance     SalaryAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  payslipId   String?  @map("payslip_id") // linked payslip (plain id, no FK — payslip may be deleted/recreated)
  amount      Decimal  @db.Decimal(12, 2)
  deductedAt  DateTime @default(now()) @map("deducted_at")

  @@index([tenantId, advanceId])
  @@index([advanceId])
  @@map("advance_deductions")
}

