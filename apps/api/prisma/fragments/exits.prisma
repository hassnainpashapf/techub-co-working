// Phase 42 Track 8: Exit / Offboarding Process
// COORDINATOR: merge into schema.prisma + add back-relations:
//   Tenant   { employeeExits EmployeeExit[] }
//   Employee { exits EmployeeExit[] }
//   User     { initiatedExits EmployeeExit[] @relation("ExitInitiator") }
// schema.prisma untouched by this track.

model EmployeeExit {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  employeeId      String    @map("employee_id")
  type            String    // resignation | termination
  lastWorkingDay  DateTime  @map("last_working_day")
  reason          String?
  noticeDays      Int?      @map("notice_days")
  clearanceItems  Json      @default("[]") @map("clearance_items") // [{title, dept, done, doneBy, doneAt}]
  status          String    @default("initiated") // initiated | clearance_pending | completed
  initiatedBy     String    @map("initiated_by")
  initiatedAt     DateTime  @default(now()) @map("initiated_at")
  completedAt     DateTime? @map("completed_at")

  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@map("employee_exits")
}

