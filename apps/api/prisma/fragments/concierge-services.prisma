// COORDINATOR: merge into schema.prisma + add back-relations:
//   Tenant { conciergeServices ConciergeService[] }
//   ServiceProvider { services ConciergeService[] }   <-- Track 3 ke model par back-relation jorna
// NOTE: ServiceProvider model Track 3 (service-providers.prisma) me canonical hai —
// yahan dobara define nahi kiya taake duplicate model na ho. ConciergeService
// Track 3 ke ServiceProvider ko reference karta hai.
// schema.prisma untouched by this track.

model ConciergeService {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  category    String // errand | food | transport | wellness | business
  description String?
  basePrice   Decimal? @map("base_price") @db.Decimal(14, 2)
  isActive    Boolean  @default(true) @map("is_active")
  providerId  String?  @map("provider_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider ServiceProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([tenantId, category])
  @@index([tenantId, isActive])
  @@map("concierge_services")
}

