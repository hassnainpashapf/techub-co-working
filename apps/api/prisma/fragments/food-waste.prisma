// schema.prisma untouched by this track.

model FoodWaste {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  date        DateTime @db.Date
  menuItemId  String?  @map("menu_item_id")
  description String
  quantity    Int
  reason      String   @default("spoiled") // spoiled | overcooked | expired | other
  costEstimate Decimal? @map("cost_estimate") @db.Decimal(12, 2)
  recordedById String  @map("recorded_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, date])
  @@index([tenantId, reason])
  @@map("food_waste")
}

