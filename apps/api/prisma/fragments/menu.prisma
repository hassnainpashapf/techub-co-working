// Phase 43 Track 1: Cafeteria Menu Management
// COORDINATOR: merge into schema.prisma + add back-relations:
//   Tenant { menuCategories MenuCategory[], menuItems MenuItem[] }
//   MenuCategory { items MenuItem[] }
// schema.prisma untouched by this track.

model MenuCategory {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  items MenuItem[]

  @@index([tenantId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  categoryId  String   @map("category_id")
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?  @map("image_url")
  isAvailable Boolean  @default(true) @map("is_available")
  tags        Json     @default("[]") // e.g. ["veg", "spicy"]
  prepTimeMin Int?     @map("prep_time_min")
  createdAt   DateTime @default(now()) @map("created_at")

  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([tenantId, categoryId])
  @@index([tenantId, isAvailable])
  @@map("menu_items")
}

