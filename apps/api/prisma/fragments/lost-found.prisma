model LostFoundItem {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String                // lost | found
  title       String
  description String?   @db.Text
  location    String?
  imageUrl    String?   @map("image_url")
  status      String    @default("open") // open | claimed | expired
  // reporter: member (prefer) ya staff user
  memberId    String?   @map("member_id")
  member      Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  reportedBy  String?   @map("reported_by") // user id (staff) fallback
  claimedBy   String?   @map("claimed_by")  // member id ya user id
  claimedAt   DateTime? @map("claimed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, type, status])
  @@map("lost_found_items")
}

