// schema.prisma untouched by this track.

// Journey blueprint: stages = [{ title, dayOffset, tasks: ["task1","task2"] }]
model OnboardingTemplate {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  stages    Json // [{ title, dayOffset, tasks: [...] }]
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journeys MemberJourney[]

  @@index([tenantId, isDefault])
  @@map("onboarding_templates")
}

model MemberJourney {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  memberId     String    @map("member_id")
  templateId   String?   @map("template_id")
  templateName String    @default("") @map("template_name") // snapshot (template badal jaye to history mehfooz)
  stageTasks   Json      @default("[]") @map("stage_tasks") // [[true,false],[true]] — stage ke tasks ka done state snapshot
  currentStage Int       @default(0) @map("current_stage")
  status       String    @default("active") // active | completed | stalled
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member   Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  template OnboardingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId, memberId, status])
  @@index([tenantId, status])
  @@map("member_journeys")
}

