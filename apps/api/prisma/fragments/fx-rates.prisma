model FxRate {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromCurrency   String   @map("from_currency") // ISO-4217, 3 chars, uppercase — rate ka base
  toCurrency     String   @map("to_currency")   // ISO-4217, 3 chars, uppercase — rate ka quote
  rate           Decimal  @db.Decimal(18, 6) @map("rate") // 1 fromCurrency = rate toCurrency
  source         String   @default("manual") @map("source") // manual | auto
  effectiveDate  DateTime @default(now()) @map("effective_date") // kis din ka rate (UTC midnight)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([tenantId, fromCurrency, toCurrency, effectiveDate])
  @@index([tenantId, fromCurrency, toCurrency, effectiveDate(sort: Desc)])
  @@map("fx_rates")
}

