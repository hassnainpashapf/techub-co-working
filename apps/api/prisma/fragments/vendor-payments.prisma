// ALSO (coordinator): add `paidAmount Decimal @default(0) @map("paid_amount")` to
// Track 4's VendorBill model (partial-payment tracking) — ALTER SQL below.
// schema.prisma untouched by this track.

model VendorPayment {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  billId    String   @map("bill_id")
  amount    Decimal  @db.Decimal(12, 2)
  method    String   @default("bank") // bank | cash | online
  reference String?
  paidAt    DateTime @default(now()) @map("paid_at")
  paidById  String   @map("paid_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  bill VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  paidBy User @relation("VendorPaidBy", fields: [paidById], references: [id], onDelete: Restrict)

  @@index([tenantId, billId])
  @@index([tenantId, paidAt])
  @@map("vendor_payments")
}

