// COORDINATOR: merge into schema.prisma + add back-relations:
//   Tenant { lockerMaintenance LockerMaintenance[] }
//   Locker { maintenanceRecords LockerMaintenance[] }
//   User   { reportedLockerMaintenance LockerMaintenance[] }
// schema.prisma untouched by this track.

model LockerMaintenance {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  lockerId   String    @map("locker_id")
  issue      String // masla ki tafseel (e.g. "talla jam hai")
  status     String    @default("open") // open | fixed
  reportedBy String?   @map("reported_by")
  reportedAt DateTime  @default(now()) @map("reported_at")
  fixedAt    DateTime? @map("fixed_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locker   Locker @relation(fields: [lockerId], references: [id], onDelete: Cascade)
  reporter User?  @relation(fields: [reportedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, lockerId])
  @@map("locker_maintenance")
}

