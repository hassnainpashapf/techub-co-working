model ParkingSpot {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label     String // e.g. A-01, B-12
  type      String   @default("car") // car | bike | vip
  status    String   @default("free") // free | occupied | reserved
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  assignments ParkingAssignment[]

  @@unique([tenantId, label])
  @@index([tenantId, status])
  @@map("parking_spots")
}

model ParkingAssignment {
  id            String       @id @default(cuid())
  tenantId      String       @map("tenant_id")
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  spotId        String       @map("spot_id")
  spot          ParkingSpot  @relation(fields: [spotId], references: [id], onDelete: Cascade)
  memberId      String       @map("member_id")
  member        Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  vehicleNumber String?      @map("vehicle_number")
  startDate     DateTime     @default(now()) @map("start_date")
  endDate       DateTime?    @map("end_date")
  status        String       @default("active") // active | ended
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([spotId, status])
  @@map("parking_assignments")
}

