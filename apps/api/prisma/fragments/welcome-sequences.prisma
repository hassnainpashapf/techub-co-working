// schema.prisma untouched by this track.

model WelcomeSequence {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  steps     Json     @default("[]") // [{dayOffset, channel: "email"|"sms"|"whatsapp", templateId?, subject?}]
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs   WelcomeLog[]

  @@index([tenantId, isActive])
  @@map("welcome_sequences")
}

model WelcomeLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  memberId   String   @map("member_id")
  sequenceId String   @map("sequence_id")
  stepIndex  Int      @map("step_index")
  channel    String   // email|sms|whatsapp
  sentAt     DateTime @default(now()) @map("sent_at")
  status     String   @default("sent") // sent|skipped|failed
  error      String?

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member   Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sequence WelcomeSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, memberId, stepIndex]) // dedupe: ek member ko ek step ek dafa
  @@index([tenantId, memberId])
  @@map("welcome_logs")
}

