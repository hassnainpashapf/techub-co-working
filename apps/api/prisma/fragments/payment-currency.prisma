model Payment {
  // ... (existing fields: id, tenantId, invoiceId, amount, method, receiptNo, paidAt, note, createdAt, refunds)

  // Payment kis currency me hui (ISO-4217, e.g. PKR | USD | EUR)
  currency String @default("PKR")

  // Payment ke waqt ka FX snapshot: 1 <currency> = fxRate <base currency>
  // Base currency me ho to fxRate = 1. Track 2 (fx-rates) se snapshot lena.
  fxRate Decimal? @map("fx_rate") @db.Decimal(18, 6)

  // Payment ka base-currency me converted amount (reports/allocation isi par)
  baseAmount Decimal? @map("base_amount") @db.Decimal(12, 2)
}

