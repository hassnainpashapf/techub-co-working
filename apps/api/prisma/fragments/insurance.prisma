// Phase 50 — Insurance Tracking
// Coordinator: merge into schema.prisma + Tenant back-relation + migration SQL below.

model InsurancePolicy {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation("TenantInsurancePolicies", fields: [tenantId], references: [id], onDelete: Cascade)
  provider         String
  policyNumber     String
  type             String   // property / liability / health / equipment
  coverageAmount   Decimal  @db.Decimal(14, 2)
  premiumAmount    Decimal  @db.Decimal(14, 2)
  premiumFrequency String   @default("yearly") // monthly / quarterly / yearly
  startDate        DateTime
  endDate          DateTime
  documentUrl      String?
  status           String   @default("active") // active / expired / cancelled
  lastReminderKey  String?  // dedupe: "<endDateISO>:<days>"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, endDate])
}

