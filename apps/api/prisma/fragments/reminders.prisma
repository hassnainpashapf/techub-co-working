model ReminderRule {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  entity     String // invoice | contract | booking | maintenance | document
  timing     String // before | after
  daysOffset Int      @map("days_offset") // e.g. 3 = 3 days before dueDate / 7 = 7 days after dueDate
  channels   String[] @default([]) // email | sms | push
  templateKey String? @map("template_key") // optional mailer template key override
  isActive   Boolean  @default(true) @map("is_active")
  createdById String? @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  logs ReminderLog[]

  @@index([tenantId, isActive])
  @@map("reminder_rules")
}

model ReminderLog {
  id           String       @id @default(cuid())
  ruleId       String       @map("rule_id")
  rule         ReminderRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  tenantId     String       @map("tenant_id")
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityId     String       @map("entity_id") // the invoice/contract/booking/... id reminded about
  channelsSent String[]     @default([]) @map("channels_sent")
  sentAt       DateTime     @default(now()) @map("sent_at")

  @@unique([ruleId, entityId]) // dedupe: same rule + entity sends exactly once
  @@index([tenantId, sentAt])
  @@map("reminder_logs")
}

