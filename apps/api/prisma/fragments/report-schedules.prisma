// Phase 52 Track 4: Scheduled delivery for custom reports.
// Coordinator merge karega — IMPORTANT: Track 1 ka `reports-builder.prisma`
// (CustomReport model) PEHLE merge hona chahiye, us ke baad ye fragment.

model ReportSchedule {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  reportId    String    @map("report_id")
  frequency   String    @default("weekly") @map("frequency") // daily | weekly | monthly
  dayOfWeek   Int?      @map("day_of_week")  // 0-6 (weekly) — default 1 (Monday)
  dayOfMonth  Int?      @map("day_of_month") // 1-28 (monthly) — default 1
  recipients  Json      @default("[]") @map("recipients") // ["a@x.com", ...]
  format      String    @default("pdf") @map("format") // csv | pdf
  isActive    Boolean   @default(true) @map("is_active")
  lastSentAt  DateTime? @map("last_sent_at")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  report CustomReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([isActive, lastSentAt])
  @@map("report_schedules")
}

