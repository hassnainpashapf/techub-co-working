model UtilityMeter {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   // e.g. "Main Electricity Meter"
  type        String   @default("electricity") // electricity | water | gas | internet
  unitId      String?  @map("unit_id") // null = building/shared meter
  unit        Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  buildingId  String?  @map("building_id")
  building    Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  meterNumber String?  @map("meter_number")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  readings UtilityMeterReading[] @relation("MeterReadings")

  @@index([tenantId, isActive])
  @@index([tenantId, type])
  @@map("utility_meters")
}

