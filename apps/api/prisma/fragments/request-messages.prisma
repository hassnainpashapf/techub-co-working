// Phase 55 Track 4: Request Chat/Thread — concierge service requests par member<->staff chat thread.
// COORDINATOR: merge into schema.prisma + add back-relations:
//   ServiceRequest { messages RequestMessage[] }
// NOTE: ServiceRequest model Track 2 (service-requests.prisma) se aata hai — usay PEHLE merge karein.
// schema.prisma untouched by this track.

model RequestMessage {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  requestId String   @map("request_id")
  senderId  String   @map("sender_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender  User           @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([tenantId, requestId, createdAt])
  @@map("request_messages")
}

