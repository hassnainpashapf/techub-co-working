//   1. Ye model copy karein
//   2. Tenant model me back-relation jorein: customReports CustomReport[]
//   3. Migration 20261003610000_phase52_reports me neeche wali SQL lagayein

model CustomReport {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  entity    String // members | invoices | bookings | payments | contracts | expenses | tickets | vendors | leads
  columns   Json // [{ field, label }] — field allowlist se validate hota hai
  filters   Json? // [{ field, op, value }]
  sorts     Json? // [{ field, dir }] — dir: asc | desc
  groupBy   String?  @map("group_by")
  isPublic  Boolean  @default(false) @map("is_public")
  ownerId   String?  @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entity])
  @@map("custom_reports")
}

