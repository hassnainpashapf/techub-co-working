// Phase 47 Track 1/10: Form Builder — CustomForm model.
// Coordinator: schema.prisma me merge karo + Tenant par back-relation joro:
//   customForms CustomForm[]
model CustomForm {
  id               String   @id @default(cuid())
  tenantId         String
  title            String
  slug             String
  description      String?
  fields           Json     // [{id, type, label, required, options?, placeholder?}]
  isPublic         Boolean  @default(false)
  status           String   @default("draft") // draft | published | archived
  submitButtonText String?  @default("Submit")
  successMessage   String?  @default("Shukriya! Aapka response mil gaya.")
  notifyEmails     Json?    // ["email@..."] — submission par email alert
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissions      FormSubmission[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, isPublic, status])
}

