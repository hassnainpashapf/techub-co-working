// Phase 48 Track 2: Member Access Credentials.
// Merge (coordinator): model + Tenant/Member back-relations -> schema.prisma,
// phir migration SQL (neeche) ko 20261003570000_phase48_access wali migration me jorein.
//
// Back-relations (schema.prisma me add karein):
//   model Tenant  { ... accessCredentials AccessCredential[] }
//   model Member  { ... accessCredentials AccessCredential[] }

model AccessCredential {
  id         String    @id @default(uuid())
  tenantId   String
  memberId   String
  type       String    // pin | rfid | mobile
  valueHash  String    // sirf hash — PIN/token kabhi plain nahi
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([tenantId, memberId, type, valueHash])
  @@index([tenantId, memberId])
  @@map("access_credentials")
}

