// Phase 51 Track 3: Utility Billing — schema fragment
// Coordinator merge kare: schema.prisma me paste + Tenant back-relations + migration SQL (neeche).
//
// DEPENDENCY: Track 1 ka `UtilityMeter` aur Track 2 ka `MeterReading` model
// PEHLE merge hone chahiyein (wahi naam brief me thay). Agar track 1/2 ke
// model names alag niklein to relation names adjust kar lena.

model UtilityRate {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type         String // electricity | water | gas | internet
  ratePerUnit  Decimal  @map("rate_per_unit") @db.Decimal(12, 4)
  fixedCharge  Decimal? @map("fixed_charge") @db.Decimal(12, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, type, effectiveFrom])
  @@map("utility_rates")
}

model UtilityBill {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId    String?  @map("member_id")
  member      Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  unitId      String?  @map("unit_id")
  meterId     String   @map("meter_id")
  meter       UtilityMeter @relation(fields: [meterId], references: [id], onDelete: Restrict)
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  consumption Decimal  @db.Decimal(12, 2)
  ratePerUnit Decimal  @map("rate_per_unit") @db.Decimal(12, 4)
  fixedCharge Decimal  @default(0) @map("fixed_charge") @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  invoiceId   String?  @map("invoice_id")
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  status      String   @default("draft") // draft | billed | void
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([tenantId, meterId, periodStart])
  @@index([tenantId, memberId])
  @@index([tenantId, status])
  @@map("utility_bills")
}

