// COORDINATOR: merge into schema.prisma + add back-relations:
//   Tenant { mealPlans MealPlan[]; memberMealPlans MemberMealPlan[] }
//   Member { mealPlans MemberMealPlan[] }
// schema.prisma untouched by this track.

model MealPlan {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String // e.g. "Monthly Lunch"
  description String?
  price       Decimal  @db.Decimal(12, 2)
  mealsPerDay Int      @default(1) @map("meals_per_day")
  validDays   Int      @default(30) @map("valid_days") // plan duration in days
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  subscriptions MemberMealPlan[]

  @@index([tenantId, isActive])
  @@map("meal_plans")
}

model MemberMealPlan {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  memberId  String   @map("member_id")
  planId    String   @map("plan_id")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  mealsUsed Int      @default(0) @map("meals_used")
  mealsTotal Int     @map("meals_total")
  status    String   @default("active") // active | expired | cancelled
  createdAt DateTime @default(now()) @map("created_at")

  plan MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([tenantId, memberId])
  @@index([tenantId, status])
  @@map("member_meal_plans")
}

