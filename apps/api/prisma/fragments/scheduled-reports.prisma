model ScheduledReport {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  name        String
  reportType  String    @map("report_type") // occupancy | revenue | expenses | churn | pnl
  frequency   String    @default("weekly") @map("frequency") // weekly | monthly
  dayOfWeek   Int?      @map("day_of_week") // 0-6 (weekly) — default 1 (Monday)
  dayOfMonth  Int?      @map("day_of_month") // 1-28 (monthly) — default 1
  recipients  Json      @default("[]") // ["a@x.com", ...]
  format      String    @default("pdf") @map("format") // pdf | csv
  isActive    Boolean   @default(true) @map("is_active")
  lastSentAt  DateTime? @map("last_sent_at")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("scheduled_reports")
}

