// Phase 48 Track 5: Visitor day passes.
// Fragment — coordinator schema.prisma me merge karega + migration SQL neeche.
// Back-relations: Tenant.dayPasses, Member.hostedDayPasses, User.createdDayPasses.

model DayPass {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitorName  String    @map("visitor_name")
  visitorPhone String?   @map("visitor_phone")
  hostMemberId String?   @map("host_member_id")
  hostMember   Member?   @relation("HostedDayPasses", fields: [hostMemberId], references: [id], onDelete: SetNull)
  code         String    @map("code") // short human code, unique per tenant
  validFrom    DateTime  @map("valid_from")
  validUntil   DateTime  @map("valid_until")
  doorIds      Json?     @map("door_ids") // array of door ids; null/empty = all doors
  status       String    @default("active") @map("status") // active | used | expired | revoked
  usedAt       DateTime? @map("used_at")
  createdById  String?   @map("created_by_id")
  createdBy    User?     @relation("CreatedDayPasses", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, validUntil])
  @@map("day_passes")
}

