model WhatsappSetting {
  id                   String   @id @default(cuid())
  tenantId             String   @unique @map("tenant_id")
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumberId        String?  @map("phone_number_id")
  accessTokenEncrypted String?  @map("access_token_encrypted")
  verifyTokenEncrypted String?  @map("verify_token_encrypted")
  appSecretEncrypted   String?  @map("app_secret_encrypted")
  businessNumber       String?  @map("business_number")
  isActive             Boolean  @default(false) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("whatsapp_settings")
}

