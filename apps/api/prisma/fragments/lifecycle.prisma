// Phase 38 Track 2: Member Lifecycle Automation — schema fragment.
// Coordinator: merge into schema.prisma + migration. DO NOT edit schema.prisma here.
//
// Triggers: trial_ending_3d | contract_expiring_30d | member_inactive_14d | invoice_overdue_7d
// Actions: email | sms
// Dedupe: per rule+member, at most one send per 30 days (LifecycleRun).

model LifecycleRule {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trigger     String    // trial_ending_3d | contract_expiring_30d | member_inactive_14d | invoice_overdue_7d
  action      String    @default("email") // email | sms
  templateKey String?   @map("template_key") // EmailTemplate key (custom or built-in); null = trigger default
  message     String?   @db.Text // custom SMS body or email customMessage override (supports {{variables}})
  isActive    Boolean   @default(true) @map("is_active")
  lastRunAt   DateTime? @map("last_run_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  runs LifecycleRun[]

  @@unique([tenantId, trigger])
  @@index([tenantId])
  @@map("lifecycle_rules")
}

model LifecycleRun {
  id        String        @id @default(cuid())
  tenantId  String        @map("tenant_id")
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ruleId    String        @map("rule_id")
  rule      LifecycleRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  memberId  String        @map("member_id")
  member    Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  channel   String        // email | sms
  sent      Boolean       @default(false)
  error     String?
  sentAt    DateTime      @default(now()) @map("sent_at")

  @@index([tenantId])
  @@index([ruleId, memberId])
  @@index([sentAt])
  @@map("lifecycle_runs")
}

