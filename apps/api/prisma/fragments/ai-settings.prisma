// (parallel tracks — merge conflicts se bachne ke liye).

model AiSetting {
  id                 String   @id @default(cuid())
  tenantId           String   @unique @map("tenant_id")
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider           String   @default("disabled") // disabled | openai | anthropic | openai-compatible
  apiKeyEncrypted    String?  @map("api_key_encrypted") // AES-256-GCM via lib/crypto.js, write-only
  baseUrl            String?  @map("base_url") // custom base URL (openai-compatible only, https enforced)
  model              String?  // e.g. gpt-4o-mini, claude-3-5-haiku
  enabledFeatures    Json?    @map("enabled_features") // { chat: true, insights: true, sentiment: true }
  monthlyTokenCap    Int?     @map("monthly_token_cap") // soft cap per tenant per month
  tokensUsedThisMonth Int     @default(0) @map("tokens_used_this_month")
  usageMonth         String   @default("") @map("usage_month") // YYYY-MM, resets when month changes
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("ai_settings")
}

