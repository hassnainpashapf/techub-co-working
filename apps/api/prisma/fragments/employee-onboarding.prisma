// NOTE: route file ka naam employee-onboarding.js hai (onboarding.js Phase 35 ka tenant wizard pehle se hai).
// schema.prisma untouched by this track.

model OnboardingTemplate {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  tasks     Json     // [{ title, dept, dayOffset }]
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("onboarding_templates")
}

model EmployeeOnboarding {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  employeeId  String    @map("employee_id")
  templateId  String?   @map("template_id")
  items       Json      // [{ title, dept, dayOffset, done, doneBy, doneAt }]
  status      String    @default("in_progress") // in_progress | completed
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([tenantId, status])
  @@index([employeeId])
  @@map("employee_onboardings")
}

