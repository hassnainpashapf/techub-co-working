// Phase 54 Track 4/10: Buddy/Mentor Program — newcomers ko experienced members assign.
// Merge (coordinator): models + Tenant/Member back-relations -> schema.prisma,
// phir migration SQL (neeche) ko phase-54 wali migration me jorein.
//
// Back-relations (schema.prisma me add karein):
//   model Tenant { ... buddyPairs BuddyPair[] }
//   model Member { ... newcomerBuddyPairs BuddyPair[] @relation("NewcomerBuddyPairs")
//                        buddyForPairs     BuddyPair[] @relation("BuddyForPairs") }

model BuddyPair {
  id         String   @id @default(uuid())
  tenantId   String
  newcomerId String
  buddyId    String
  assignedAt DateTime @default(now())
  status     String   @default("active") // active | completed
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  newcomer Member @relation("NewcomerBuddyPairs", fields: [newcomerId], references: [id], onDelete: Cascade)
  buddy    Member @relation("BuddyForPairs", fields: [buddyId], references: [id], onDelete: Cascade)

  @@unique([newcomerId, buddyId]) // ek jodi ek dafa — dobara assign = naya notes ke sath edit
  @@index([tenantId, status])
  @@index([buddyId])
  @@index([newcomerId])
  @@map("buddy_pairs")
}

