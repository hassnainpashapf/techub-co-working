// Phase 54 Track 7: Success Manager Tasks
// COORDINATOR: merge into schema.prisma + add back-relations:
//   Tenant { successTasks SuccessTask[] }
//   Member { successTasks SuccessTask[] }
//   User { assignedSuccessTasks SuccessTask[] }
// schema.prisma untouched by this track.

model SuccessTask {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  memberId    String   @map("member_id")
  title       String
  dueAt       DateTime @map("due_at")
  status      String   @default("open") // open | done | overdue
  assignedTo  String?  @map("assigned_to")
  notes       String?
  source      String   @default("manual") // manual | health-alert | journey-stalled | nps
  createdBy   String?  @map("created_by")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assignee User?  @relation("SuccessTaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, memberId])
  @@index([tenantId, assignedTo])
  @@map("success_tasks")
}

