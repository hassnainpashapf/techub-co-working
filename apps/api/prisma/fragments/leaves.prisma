// Phase 42 Track 3: Leave Management — EXTENDS existing Leave model (additive delta)
// NOTE: `Leave` model (userId-based, LeaveStatus enum) schema.prisma me pehle se maujood hai
// (attendance.js use karta hai) — usay replace nahi, sirf 2 columns jodne hain.
// COORDINATOR: merge into schema.prisma + back-relations:
//   Tenant   { leaveBalances LeaveBalance[] }
//   Employee { leaveBalances LeaveBalance[] }   // Employee = employees.prisma (Track 1)
// schema.prisma untouched by this track.

model LeaveBalance {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year       Int
  type       String   @default("annual") // annual | sick | casual | unpaid
  allocated  Int      @default(0)
  used       Int      @default(0) @map("used")

  @@unique([tenantId, employeeId, year, type])
  @@index([tenantId, year])
  @@map("leave_balances")
}

