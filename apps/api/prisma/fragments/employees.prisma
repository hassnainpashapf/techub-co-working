// Phase 42 Track 1: Employee Directory
// COORDINATOR: merge into schema.prisma + add back-relations:
//   Tenant { employees Employee[] }
//   User   { employee Employee? }   // optional link (userId unique)
// schema.prisma untouched by this track.

model Employee {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  userId           String?  @unique @map("user_id") // linked login (User)
  name             String
  email            String?
  phone            String?
  department       String   @default("ops") // ops | finance | sales | admin | support
  designation      String   @default("Staff")
  joiningDate      DateTime @default(now()) @map("joining_date")
  employmentType   String   @default("full_time") @map("employment_type") // full_time | part_time | contract
  status           String   @default("active") // active | on_leave | exited
  emergencyContact String?  @map("emergency_contact")
  cnic             String?
  address          String?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@index([tenantId, department])
  @@map("employees")
}

