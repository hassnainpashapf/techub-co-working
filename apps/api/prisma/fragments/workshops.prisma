// Phase 53 Track 6/10: Live Workshop Sessions — live (Zoom/Meet/in-person) sessions.
// Merge (coordinator): models + Tenant/Course/Member back-relations -> schema.prisma,
// phir migration SQL (neeche) ko 20261003620000_phase53_academy wali migration me jorein.
//
// Back-relations (schema.prisma me add karein):
//   model Tenant { ... workshops Workshop[] workshopBookings WorkshopBooking[] }
//   model Course { ... workshops Workshop[] }
//   model Member { ... workshopBookings WorkshopBooking[] }

model Workshop {
  id          String    @id @default(uuid())
  tenantId    String
  courseId    String?
  title       String
  description String?
  instructorId String?
  scheduledAt DateTime
  durationMin Int        @default(60)
  meetingUrl  String?
  capacity    Int?
  status      String     @default("scheduled") // scheduled | ongoing | completed | cancelled
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  bookings WorkshopBooking[]

  @@index([tenantId, scheduledAt])
  @@index([courseId])
  @@map("workshops")
}

model WorkshopBooking {
  id         String   @id @default(uuid())
  tenantId   String
  workshopId String
  memberId   String
  status     String   @default("booked") // booked | attended | cancelled
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([workshopId, memberId])
  @@index([tenantId, workshopId])
  @@index([memberId])
  @@map("workshop_bookings")
}

