// Phase 45 Track 4: Weekly AI Insights Engine — schema fragment.
// Coordinator: merge this model into apps/api/prisma/schema.prisma
// and create the matching migration. DO NOT edit schema.prisma here
// (parallel tracks — merge conflicts se bachne ke liye).
//
// Har Monday job `generateWeeklyInsights(tenantId)` har type ka ek Insight
// row banata/upsert karta hai (dedupe @@unique([tenantId, week, type])).
// Dashboard unread insights dikhata hai; staff read/dismiss karta hai.

model Insight {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  week      DateTime @map("week") @db.Date // us Monday ki date jis week ke liye insight hai
  type      String   // revenue | occupancy | churn | billing | leases
  title     String
  body      String   @db.Text // rule-based text, ya LLM polished
  severity  String   @default("info") @map("severity") // info | warning | critical
  data      Json?    // detector ke asal numbers (JSON)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, week, type])
  @@index([tenantId, week])
  @@index([tenantId, isRead])
  @@map("insights")
}

