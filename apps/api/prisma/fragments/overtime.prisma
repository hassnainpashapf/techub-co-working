// Phase 42 Track 4: Overtime Tracking
// COORDINATOR: merge into schema.prisma + add back-relations:
//   Employee { overtime Overtime[] }
//   Tenant   { overtime Overtime[] }
//   User     { overtimeDecided Overtime[] @relation("OvertimeDecided") }
// schema.prisma untouched by this track.

model Overtime {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  employeeId  String   @map("employee_id")
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  minutes     Int      // overtime minutes worked
  reason      String
  status      String   @default("pending") // pending | approved | rejected
  requestedAt DateTime @default(now()) @map("requested_at")
  decidedBy   String?  @map("decided_by")
  decider     User?    @relation("OvertimeDecided", fields: [decidedBy], references: [id], onDelete: SetNull)
  decidedAt   DateTime? @map("decided_at")

  @@unique([employeeId, date])
  @@index([tenantId, status])
  @@index([tenantId, date])
  @@map("overtime")
}

