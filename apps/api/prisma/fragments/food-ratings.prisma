// Phase 43 Track 7: Food Item Ratings
// COORDINATOR: merge into schema.prisma + add back-relations:
//   Tenant { foodRatings FoodRating[] }
//   MenuItem { ratings FoodRating[] }
//   Member { foodRatings FoodRating[] }
// schema.prisma untouched by this track.

model FoodRating {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  menuItemId String   @map("menu_item_id")
  memberId   String   @map("member_id")
  score      Int // 1..5
  comment    String?
  ratedAt    DateTime @default(now()) @map("rated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, memberId]) // ek member ek item ko ek dafa rate karta hai (dobara = update)
  @@index([tenantId, menuItemId])
  @@index([tenantId, memberId])
  @@map("food_ratings")
}

