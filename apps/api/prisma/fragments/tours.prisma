model Tour {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId            String    @map("lead_id")
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  scheduledAt       DateTime  @map("scheduled_at")
  durationMin       Int       @default(30) @map("duration_min")
  assignedTo        String?   @map("assigned_to") // host staff userId
  assignee          User?     @relation("TourAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  status            String    @default("scheduled") // scheduled | completed | cancelled | no_show
  notes             String?   @db.Text
  outcome           String?   // completed par: interested | not_interested | undecided
  reminder24hSentAt  DateTime? @map("reminder_24h_sent_at")
  reminder2hSentAt   DateTime? @map("reminder_2h_sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, scheduledAt])
  @@index([leadId])
  @@map("tours")
}

