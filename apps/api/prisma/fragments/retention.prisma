model RetentionPolicy {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dataType   String   @map("data_type") // logs | messages | visitors | marketing
  retainDays Int      @map("retain_days") // purana data is se zyada din ka ho to process
  autoDelete Boolean  @default(false) @map("auto_delete") // true = delete, false = anonymize jahan mumkin
  createdAt  DateTime @default(now()) @map("created_at")

  runs RetentionRun[]

  @@unique([tenantId, dataType])
  @@index([tenantId])
  @@map("retention_policies")
}

model RetentionRun {
  id        String          @id @default(cuid())
  tenantId  String          @map("tenant_id")
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policyId  String?         @map("policy_id")
  policy    RetentionPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  dataType  String          @map("data_type")
  mode      String          // dry_run | live
  scanned   Int             @default(0)
  deleted   Int             @default(0)
  anonymized Int            @default(0)
  details   Json?
  runBy     String?         @map("run_by")
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("retention_runs")
}

