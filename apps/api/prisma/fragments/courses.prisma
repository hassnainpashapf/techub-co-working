// Phase 53 Track 1/10: Course Catalog — Course + Lesson models.
// Coordinator: schema.prisma me merge karo + Tenant aur User par back-relations joro:
//   Tenant:  courses Course[]
//   User:    taughtCourses Course[]  @relation("CourseInstructor")
model Course {
  id           String   @id @default(cuid())
  tenantId     String
  title        String
  slug         String
  description  String?
  category     String   @default("general") // general | soft-skills | tech | business | wellness
  level        String   @default("beginner") // beginner | intermediate | advanced
  thumbnailUrl String?
  instructorId String?
  isPublished  Boolean  @default(false)
  price        Float?
  durationMin  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instructor User?    @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  lessons    Lesson[]

  @@unique([tenantId, slug])
  @@index([tenantId, isPublished])
  @@index([tenantId, category])
  @@index([instructorId])
}

model Lesson {
  id         String   @id @default(cuid())
  courseId   String
  title      String
  type       String   @default("text") // video | text | file | quiz
  contentUrl String?
  body       String?  // text lesson content (rich text/markdown)
  durationMin Int?
  sortOrder  Int      @default(0)
  isFree     Boolean  @default(false) // preview ke liye free
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, sortOrder])
}

