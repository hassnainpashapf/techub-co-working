// Phase 43 Track 2: Member Ordering (Cafeteria & F&B Pack) — fragment.
// Coordinator merges this into apps/api/prisma/schema.prisma (additive).
// Back-relations needed: Tenant -> foodOrders FoodOrder[], Member -> foodOrders FoodOrder[]

model FoodOrder {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId     String    @map("member_id")
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // items: [{ menuItemId?, name, qty, price }] — price snapshot at order time
  items        Json      @map("items")
  subtotal     Decimal   @db.Decimal(12, 2) @map("subtotal")
  // pending -> preparing -> ready -> delivered ; cancelled from pending/preparing
  status       String    @default("pending") @map("status")
  deliveryZone String?   @map("delivery_zone")
  note         String?   @map("note")
  orderedAt    DateTime  @default(now()) @map("ordered_at")
  readyAt      DateTime? @map("ready_at")
  deliveredAt  DateTime? @map("delivered_at")

  @@index([tenantId, memberId])
  @@index([tenantId, status])
  @@map("food_orders")
}

