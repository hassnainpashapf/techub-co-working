// Phase 31 Track 3: Dunning (overdue reminders) — schema fragment.
// Coordinator: merge into schema.prisma + migration. DO NOT edit schema.prisma here.

model DunningLog {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId String   @map("invoice_id")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  level     Int      // 1 = polite (1-7d overdue), 2 = firm (8-21d), 3 = final notice (22d+)
  channel   String   @default("email")
  sentAt    DateTime @default(now()) @map("sent_at")
  error     String?

  @@unique([invoiceId, level])
  @@index([tenantId])
  @@index([invoiceId])
  @@map("dunning_logs")
}

