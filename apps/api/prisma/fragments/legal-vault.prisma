// Phase 50 Track 4: Legal Document Vault — schema fragment.
// Fragment — coordinator schema.prisma me merge karega + migration SQL neeche.
// Back-relations: Tenant.legalDocuments, Member.legalDocuments ("MemberLegalDocs"),
// Vendor.legalDocuments ("VendorLegalDocs"), User.createdLegalDocuments ("CreatedLegalDocs").
//
// Deviation note (coordinator ke liye): brief me `reminderDays? @default(30)` tha,
// lekin Phase 38 ke document-expiry pattern (Json [30,7,1]) ko reuse kiya hai taake
// 30/7/1 din pehle notifications ek hi column se chal sakein — koi extra table nahi.
// `status` column store hota hai (active/archived); valid/expiring/expired
// `expiresAt` se DERIVE hota hai (API responses me `expiry.status` + `expiry.daysLeft`
// computed fields ke tor par aata hai) — Phase 38 wala pattern.

model LegalDocument {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String    @map("title")
  category        String    @map("category") // contract | nda | license | insurance | other
  fileUrl         String?   @map("file_url") // storage path (local absolute path ya s3://...)
  fileName        String?   @map("file_name")
  fileMime        String?   @map("file_mime")
  fileSize        Int?      @map("file_size")
  relatedMemberId String?   @map("related_member_id")
  relatedMember   Member?   @relation("MemberLegalDocs", fields: [relatedMemberId], references: [id], onDelete: SetNull)
  relatedVendorId String?   @map("related_vendor_id")
  relatedVendor   Vendor?   @relation("VendorLegalDocs", fields: [relatedVendorId], references: [id], onDelete: SetNull)
  expiresAt       DateTime? @map("expires_at")
  reminderDays    Json      @default("[30,7,1]") @map("reminder_days") // kin daysLeft par remind: [30,7,1]
  lastReminderKey String?   @map("last_reminder_key") // dedupe: "<expiresAtISO>:<days|expired>"
  status          String    @default("active") @map("status") // active | archived
  createdById     String?   @map("created_by_id")
  createdBy       User?     @relation("CreatedLegalDocs", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, category])
  @@index([tenantId, status])
  @@index([expiresAt])
  @@map("legal_documents")
}

