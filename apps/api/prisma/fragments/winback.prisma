// Phase 54 Track 8: Win-Back Campaigns
// COORDINATOR: merge into schema.prisma + add back-relations:
//   Tenant { winbackCampaigns WinbackCampaign[] }
//   WinbackCampaign { logs WinbackLog[] }
//   Member { winbackLogs WinbackLog[] }
// schema.prisma untouched by this track.

model WinbackCampaign {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  name         String
  targetFilter Json     @default("{}") // { inactiveDays: 60, plans: ["starter"], minInactiveDays }
  offerText    String?  @map("offer_text")
  subject      String?  // email subject override
  status       String   @default("draft") // draft | active | done
  sentCount    Int      @default(0) @map("sent_count")
  lastRunAt    DateTime? @map("last_run_at")
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs   WinbackLog[]

  @@index([tenantId, status])
  @@map("winback_campaigns")
}

model WinbackLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  campaignId String   @map("campaign_id")
  memberId   String   @map("member_id")
  email      String
  status     String   @default("sent") // sent | skipped | failed
  error      String?
  sentAt     DateTime @default(now()) @map("sent_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign WinbackCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  member   Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, memberId]) // dedupe: ek member ko ek campaign me ek dafa
  @@index([tenantId, memberId])
  @@map("winback_logs")
}

