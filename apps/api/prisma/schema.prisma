// Coworking SaaS — multi-tenant data model (MVP)
// Every business table carries tenantId. The `super_admin` role has tenantId = null (global).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- roles ---
enum Role {
  super_admin
  ceo
  admin
  operations_manager
  manager
  finance_officer
  receptionist
  office_boy
  member
}

// --------------------------------------------------------------- tenant ---
model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  email        String?
  phone        String?
  address      String?
  plan         String   @default("starter") // starter | growth | enterprise
  isActive     Boolean  @default(true) @map("is_active")
  suspendedAt  DateTime? @map("suspended_at") // Phase 35: tenant suspension
  suspendedReason String? @map("suspended_reason")
  logoPath     String?  @map("logo_path")
  primaryColor String?  @map("primary_color")
  tagline      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users                   User[]
  buildings               Building[]
  floors                  Floor[]
  zones                   Zone[]
  units                   Unit[]
  members                 Member[]
  contracts               Contract[]
  membershipPlans         MembershipPlan[]
  invoices                Invoice[]
  payments                Payment[]
  expenses                Expense[]
  attendance              AttendanceRecord[]
  leaves                  Leave[]
  tasks                   Task[]
  bookings                Booking[]
  notifications           Notification[]
  tickets                 Ticket[]
  ticketComments          TicketComment[]
  visitors                Visitor[]
  maintenanceOrders       MaintenanceOrder[]
  inventoryItems          InventoryItem[]
  inventoryMovements      InventoryMovement[]
  assets                  Asset[]
  documents               Document[]
  creditNotes             CreditNote[]
  refunds                 Refund[]
  rides                   Ride[]
  rideRequests            RideRequest[]
  webhooks                Webhook[]
  webhookDeliveries       WebhookDelivery[]
  unitFavorites           UnitFavorite[]
  companies               Company[]
  apiKeys                 ApiKey[]
  emailSetting            EmailSetting?
  settings                Setting[]
  auditLogs               AuditLog[]
  subscription            TenantSubscription?
  smsLogs                 SmsLog[]
  whatsappLogs            WhatsappLog[]
  announcements           Announcement[]
  notificationPreferences NotificationPreference[]
  jobs                    Job[]
  recurringBookings       RecurringBooking[]
  leads                   Lead[]
  leadActivities          LeadActivity[]
  tours                   Tour[]
  quotations              Quotation[]
  leadFollowups           LeadFollowup[]
  feedback                Feedback[]
  emailTemplates          EmailTemplate[]
  savedViews              SavedView[]
  bookingRequests         BookingRequest[]
  salaryStructures        SalaryStructure[]
  payrollRuns             PayrollRun[]
  recurringInvoices       RecurringInvoice[]
  dunningLogs             DunningLog[]
  onlinePayments          OnlinePayment[]
  budgets                 Budget[]
  pettyCashTransactions   PettyCashTransaction[]
  loginAlerts             LoginAlert[]
  auditArchives           AuditArchive[]
  backupRecords           BackupRecord[]
  communityEvents         CommunityEvent[]
  referralCodes           ReferralCode[]
  referrals               Referral[]
  loyaltyLedger           LoyaltyLedger[]
  marketplaceListings     MarketplaceListing[]
  surveys                 Survey[]
  visitorInvites          VisitorInvite[]
  shifts                  Shift[]
  shiftTemplates          ShiftTemplate[]
  facilityAssets          FacilityAsset[]
  facilityAssetCheckouts  FacilityAssetCheckout[]
  maintenanceRequests     MaintenanceRequest[]
  parkingSpots            ParkingSpot[]
  parkingAssignments      ParkingAssignment[]
  mailItems               MailItem[]
  printCredits            PrintCredit[]
  printJobs               PrintJob[]
  wifiVouchers            WifiVoucher[]
  lostFoundItems          LostFoundItem[]
  cleaningTasks           CleaningTask[]
  kpiDashboards           KpiDashboard[] // Phase 35
  // Phase 36: Integrations & API Pack
  calendarSyncLogs        CalendarSyncLog[]
  slackIntegration        SlackIntegration?
  contractSignatures      ContractSignature[]
  emailCampaigns          EmailCampaign[]
  emailUnsubscribes       EmailUnsubscribe[]
  apiUsageLogs            ApiUsageLog[]
  calendarFeedTokens      CalendarFeedToken[]
  smsCampaigns            SmsCampaign[]
  // Phase 38: Automation & Growth Pack
  scheduledReports        ScheduledReport[]
  lifecycleRules          LifecycleRule[]
  lifecycleRuns           LifecycleRun[]
  automationRules         AutomationRule[]
  automationRuns          AutomationRun[]
  waitingListEntries      WaitingListEntry[]
  feedbackUpvotes         FeedbackUpvote[]
  reminderRules           ReminderRule[]
  reminderLogs            ReminderLog[]

  @@map("tenants")
  celebrationLogs CelebrationLog[]
  perks            Perk[]
  perkClaims       PerkClaim[]
  conversations    Conversation[]
  polls            Poll[]
  pollVotes        PollVote[]
  badges           Badge[]
  newsletters      Newsletter[]
  memberIntros     MemberIntro[]
  // Phase 41: Vendor & Procurement Pack
  vendors          Vendor[]
  vendorContracts  VendorContract[]
  vendorBills      VendorBill[]
  vendorPayments   VendorPayment[]
  vendorRatings    VendorRating[]   @relation("TenantVendorRatings")
  purchaseOrders   PurchaseOrder[]
  poApprovals      POApproval[]
  goodsReceipts    GoodsReceipt[]   @relation("TenantGoodsReceipts")
  // Phase 42: HR & Payroll Pro Pack
  employees            Employee[]
  staffAttendance      StaffAttendance[]
  leaveBalances        LeaveBalance[]
  overtime             Overtime[]
  performanceReviews   PerformanceReview[]
  salaryAdvances       SalaryAdvance[]
  advanceDeductions    AdvanceDeduction[]
  onboardingTemplates  OnboardingTemplate[]
  employeeOnboardings  EmployeeOnboarding[]
  employeeExits        EmployeeExit[]
  // Phase 43: Cafeteria & F&B Pack
  menuCategories       MenuCategory[]
  menuItems            MenuItem[]
  foodOrders           FoodOrder[]
  deliveryZones        DeliveryZone[]
  mealPlans            MealPlan[]
  memberMealPlans      MemberMealPlan[]
  foodRatings          FoodRating[]
  cafeStaff            CafeStaff[]
  foodWaste            FoodWaste[]
  // Phase 44: Events & Ticketing Pro Pack
  ticketTypes          TicketType[]
  eventTickets         EventTicket[]
  ticketTransfers      TicketTransfer[]
  eventSponsors        EventSponsor[]
  eventSpeakers        EventSpeaker[]
  eventSessions        EventSession[]
  // Phase 45: AI & Intelligence Pack
  aiSetting            AiSetting?
  insights             Insight[]
  // Phase 46: Multi-Currency & International Pack
  currencySetting      CurrencySetting?
  fxRates              FxRate[]
  fxGainLoss           FxGainLoss[]
}

// ----------------------------------------------------------------- user ---
model User {
  id              String    @id @default(cuid())
  tenantId        String?   @map("tenant_id") // null => super_admin (global)
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  email           String    @unique
  passwordHash    String    @map("password_hash")
  role            Role      @default(member)
  phone           String?
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  totpSecret      String?   @map("totp_secret") // encrypted TOTP secret for 2FA
  totpEnabled     Boolean   @default(false) @map("totp_enabled")
  // Link for the member portal: a login that belongs to a Member record.
  memberId        String?   @unique @map("member_id")
  member          Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  attendanceRecords           AttendanceRecord[]
  leaves                      Leave[]
  assignedTasks               Task[]                   @relation("TaskAssignee")
  createdTasks                Task[]                   @relation("TaskCreator")
  notifications               Notification[]
  auditLogs                   AuditLog[]
  sessions                    Session[]
  passwordResets              PasswordReset[]
  emailVerifications          EmailVerification[]
  reportedTickets             Ticket[]                 @relation("TicketReporter")
  assignedTickets             Ticket[]                 @relation("TicketAssignee")
  ticketComments              TicketComment[]
  createdVisitors             Visitor[]
  assignedMaintenance         MaintenanceOrder[]
  createdMaintenance          MaintenanceOrder[]       @relation("MaintenanceCreator")
  inventoryMovements          InventoryMovement[]
  uploadedDocuments           Document[]
  createdCreditNotes          CreditNote[]
  requestedRefunds            Refund[]                 @relation("RefundRequester")
  processedRefunds            Refund[]                 @relation("RefundProcessor")
  offeredRides                Ride[]
  rideRequests                RideRequest[]
  unitFavorites               UnitFavorite[]
  sentAnnouncements           Announcement[]           @relation("SentAnnouncements")
  notificationPreferences     NotificationPreference[]
  assignedLeads               Lead[]                   @relation("LeadAssignee")
  leadActivitiesCreated     LeadActivity[]           @relation("LeadActivityCreator")
  assignedTours             Tour[]                   @relation("TourAssignee")
  createdQuotations         Quotation[]              @relation("QuotationCreator")
  assignedLeadFollowups     LeadFollowup[]           @relation("LeadFollowupAssignee")
  savedViews                  SavedView[]
  salaryStructures            SalaryStructure[]        @relation("SalaryStructures")
  payslips                    Payslip[]                @relation("Payslips")
  pettyCashTransactions       PettyCashTransaction[]
  refreshTokens               RefreshToken[]
  userSessions                UserSession[]
  loginAlerts                 LoginAlert[]
  createdEvents               CommunityEvent[]         @relation("EventCreator")
  shifts                      Shift[]                  @relation("ShiftUser")
  shiftTemplates              ShiftTemplate[]          @relation("ShiftTemplateUser")
  facilityAssetCheckouts      FacilityAssetCheckout[]
  reportedMaintenanceRequests MaintenanceRequest[]     @relation("RequestReporter")
  assignedMaintenanceRequests MaintenanceRequest[]     @relation("RequestAssignee")
  assignedCleaningTasks       CleaningTask[]           @relation("CleaningTaskAssignee")
  pushSubscriptions           PushSubscription[]
  announcementReads           AnnouncementRead[]       @relation("AnnouncementReads")
  kpiDashboards               KpiDashboard[]           @relation("KpiDashboardOwner") // Phase 35
  calendarConnections         CalendarConnection[] // Phase 36

  @@index([tenantId, role])
  @@map("users")
  conversationParticipants   ConversationParticipant[]
  sentMessages               Message[]
  // Phase 41: Vendor & Procurement Pack
  requestedPOs               PurchaseOrder[]  @relation("PORequester")
  approvedPOs                PurchaseOrder[]  @relation("POApprover")
  poDecisions                POApproval[]     @relation("POApprovalApprover")
  goodsReceiptsReceived      GoodsReceipt[]   @relation("UserGoodsReceiptsReceived")
  vendorBillApprovals        VendorBill[]     @relation("VendorBillApprover")
  vendorPaymentsMade         VendorPayment[]  @relation("VendorPaidBy")
  // Phase 43: Cafeteria & F&B Pack
  foodWasteLogged            FoodWaste[]      @relation("FoodWasteLogged")
  vendorRatings              VendorRating[]   @relation("UserVendorRatings")
  // Phase 42: HR & Payroll Pro Pack
  employee               Employee?
  overtimeDecided        Overtime[]      @relation("OvertimeDecided")
  reviewsGiven           PerformanceReview[] @relation("ReviewReviewer")
  salaryAdvancesDecided  SalaryAdvance[] @relation("AdvanceDecidedBy")
  initiatedExits         EmployeeExit[]  @relation("ExitInitiator")
}

// ---------------------------------------------------------------- space ---
model Building {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // e.g. "Gulberg Campus"
  address   String?
  city      String?
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  floors    Floor[]

  @@index([tenantId])
  @@map("buildings")
}

model Floor {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buildingId String?   @map("building_id")
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  name       String // e.g. "Ground Floor"
  level      Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  zones      Zone[]

  @@index([tenantId, buildingId])
  @@map("floors")
}

model Zone {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  floorId   String   @map("floor_id")
  floor     Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name      String // e.g. "Zone A"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  units     Unit[]

  @@map("zones")
}

enum UnitType {
  hot_desk
  dedicated_desk
  cabin
  meeting_room
  phone_booth
  virtual_office
  accommodation
}

enum UnitStatus {
  vacant
  occupied
  maintenance
}

model Unit {
  id           String     @id @default(cuid())
  tenantId     String     @map("tenant_id")
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zoneId       String     @map("zone_id")
  zone         Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  code         String // e.g. "HD-01" — unique per tenant
  type         UnitType
  status       UnitStatus @default(vacant)
  monthlyPrice Decimal    @map("monthly_price") @db.Decimal(12, 2)
  capacity     Int        @default(1)
  amenities    String[]   @default([])
  posX         Int        @default(0) @map("pos_x") // floor-plan grid X
  posY         Int        @default(0) @map("pos_y") // floor-plan grid Y
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  contracts           Contract[]
  bookings            Booking[]
  tickets             Ticket[]
  maintenanceOrders   MaintenanceOrder[]
  assets              Asset[]
  maintenanceRequests MaintenanceRequest[]
  cleaningTasks       CleaningTask[]
  favorites           UnitFavorite[]

  recurringBookings RecurringBooking[]
  bookingRequests   BookingRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, type, status])
  @@map("units")
}

// --------------------------------------------------------------- member ---
enum MemberStatus {
  active
  trial
  on_hold
  exited
}

model Member {
  id               String       @id @default(cuid())
  tenantId         String       @map("tenant_id")
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  phone            String
  cnic             String?
  companyName      String?      @map("company_name")
  emergencyContact String?      @map("emergency_contact")
  status           MemberStatus @default(active)
  notes            String?
  creditLimit      Decimal?     @map("credit_limit") @db.Decimal(12, 2) // null = unlimited
  directoryOptIn   Boolean      @default(false) @map("directory_opt_in")
  directoryBio     String?      @map("directory_bio")
  directoryTags    String[]     @default([]) @map("directory_tags")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  user         User?
  contracts    Contract[]
  invoices     Invoice[]
  bookings     Booking[]
  tickets      Ticket[]
  hostedVisits Visitor[]
  documents    Document[]
  creditNotes  CreditNote[]
  refunds      Refund[]

  recurringBookings      RecurringBooking[]
  leadConversions        Lead[]                  @relation("LeadConversion")
  feedback               Feedback[]
  recurringInvoices      RecurringInvoice[]
  eventRsvps             EventRsvp[]
  referralCodes          ReferralCode[]          @relation("MemberReferralCodes")
  loyaltyLedger          LoyaltyLedger[]
  marketplaceListings    MarketplaceListing[]
  surveyResponses        SurveyResponse[]
  surveyInvites          SurveyInvite[]
  visitorInvites         VisitorInvite[]
  facilityAssetCheckouts FacilityAssetCheckout[]
  maintenanceRequests    MaintenanceRequest[]    @relation("RequestingMember")
  parkingAssignments     ParkingAssignment[]
  mailItems              MailItem[]
  printCredits           PrintCredit[]
  printJobs              PrintJob[]
  wifiVouchers           WifiVoucher[]
  lostFoundItems         LostFoundItem[]
  calendarFeedTokens     CalendarFeedToken[] // Phase 36
  // Phase 38: Automation & Growth Pack
  lifecycleRuns           LifecycleRun[]
  convertedFromWaitingList WaitingListEntry? @relation("WaitingListConversion")

  @@index([tenantId, status])
  @@map("members")
  dateOfBirth                DateTime?                @map("date_of_birth")
  celebrationLogs            CelebrationLog[]
  perkClaims                 PerkClaim[]
  conversationParticipants   ConversationParticipant[]
  sentMessages               Message[]
  eventCheckins              EventCheckin[]
  memberBadges               MemberBadge[]
  newsletterSends            NewsletterSend[]
  introsAsNew                MemberIntro[] @relation("IntroNew")
  introsAsSuggested          MemberIntro[] @relation("IntroSuggested")
  // Phase 43: Cafeteria & F&B Pack
  foodOrders                 FoodOrder[]
  mealPlans                  MemberMealPlan[]
  foodRatings                FoodRating[]
  // Phase 44: Events & Ticketing Pro Pack
  eventTickets               EventTicket[]
}

// ------------------------------------------------------------ company ------
model Company {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  industry  String?
  email     String?
  phone     String?
  address   String?
  website   String?
  logoPath  String?  @map("logo_path")
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members Member[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("companies")
}

// -------------------------------------------------------- membership plan ---
model MembershipPlan {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String // e.g. "Hot Desk Monthly"
  description  String?
  price        Decimal   @db.Decimal(12, 2)
  billingCycle String    @default("monthly") @map("billing_cycle") // monthly | quarterly | yearly
  unitType     UnitType? @map("unit_type") // null = any unit type
  features     String[]  @default([])
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  contracts Contract[]

  @@index([tenantId, isActive])
  @@map("membership_plans")
}

// ------------------------------------------------------------- contract ---
enum ContractStatus {
  active
  expired
  cancelled
}

model Contract {
  id         String          @id @default(cuid())
  tenantId   String          @map("tenant_id")
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId   String          @map("member_id")
  member     Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  unitId     String          @map("unit_id")
  unit       Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  startDate  DateTime        @map("start_date") @db.Date
  endDate    DateTime?       @map("end_date") @db.Date
  rentAmount Decimal         @map("rent_amount") @db.Decimal(12, 2)
  rentCurrency String        @default("PKR") @map("rent_currency") // Phase 46: ISO-4217 rent currency
  status     ContractStatus  @default(active)
  planId     String?         @map("plan_id")
  plan       MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  invoices Invoice[]
  signatures ContractSignature[] // Phase 36

  @@index([tenantId, status])
  @@map("contracts")
}

// -------------------------------------------------------------- billing ---
enum InvoiceStatus {
  unpaid
  partial
  paid
  overdue
  cancelled
}

model Invoice {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId    String        @map("member_id")
  member      Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contractId  String?       @map("contract_id")
  contract    Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  number      String // e.g. INV-202610-0001 — unique per tenant
  periodStart DateTime      @map("period_start") @db.Date
  periodEnd   DateTime      @map("period_end") @db.Date
  dueDate     DateTime      @map("due_date") @db.Date
  amount      Decimal       @db.Decimal(12, 2)
  amountPaid  Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status      InvoiceStatus @default(unpaid)
  invoiceType String        @default("standard") @map("invoice_type") // standard | proforma
  // Phase 46: multi-currency
  currency   String   @default("PKR") @map("currency") // ISO-4217 invoice currency
  fxRate     Decimal? @map("fx_rate") @db.Decimal(18, 6) // 1 currency = fxRate baseCurrency
  baseAmount Decimal? @map("base_amount") @db.Decimal(12, 2) // total in base currency
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  payments       Payment[]
  creditNotes    CreditNote[]
  dunningLogs    DunningLog[]
  onlinePayments OnlinePayment[]
  fxGainLoss     FxGainLoss[] // Phase 46

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, memberId])
  @@index([tenantId, invoiceType])
  @@map("invoices")
}

model Payment {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId String   @map("invoice_id")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  method    String // cash | bank_transfer | jazzcash | easypaisa | card
  receiptNo String?  @map("receipt_no")
  paidAt    DateTime @default(now()) @map("paid_at")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  refunds   Refund[]
  // Phase 46: multi-currency
  currency   String   @default("PKR") // ISO-4217 payment currency
  fxRate     Decimal? @map("fx_rate") @db.Decimal(18, 6)
  baseAmount Decimal? @map("base_amount") @db.Decimal(12, 2)
  fxGainLoss FxGainLoss[] // Phase 46

  @@index([tenantId, invoiceId])
  @@map("payments")
}

// --------------------------------------------------- Phase 46: currency ---
model CurrencySetting {
  id                   String  @id @default(cuid())
  tenantId             String  @unique @map("tenant_id")
  tenant               Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baseCurrency         String  @default("PKR") @map("base_currency") // ISO-4217 reporting currency
  enabledCurrencies    Json?   @map("enabled_currencies") // ["PKR","USD","EUR"]
  defaultInvoiceCurrency String? @map("default_invoice_currency")
  fxSource             String  @default("manual") @map("fx_source") // manual | auto
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("currency_settings")
}

model FxRate {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromCurrency  String   @map("from_currency")
  toCurrency    String   @map("to_currency")
  rate          Decimal  @db.Decimal(18, 6) @map("rate")
  source        String   @default("manual") @map("source") // manual | auto
  effectiveDate DateTime @default(now()) @map("effective_date")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([tenantId, fromCurrency, toCurrency, effectiveDate])
  @@index([tenantId, fromCurrency, toCurrency, effectiveDate(sort: Desc)])
  @@map("fx_rates")
}

model FxGainLoss {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId String?   @map("invoice_id")
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentId String?   @map("payment_id")
  payment   Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amount    Decimal   @db.Decimal(12, 2) // base currency; +gain | -loss
  reason    String    // rate_change | rounding
  expenseId String?   @map("expense_id")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, invoiceId])
  @@index([tenantId, paymentId])
  @@map("fx_gain_loss")
}

