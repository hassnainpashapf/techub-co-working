// Coworking SaaS — multi-tenant data model (MVP)
// Every business table carries tenantId. The `super_admin` role has tenantId = null (global).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- roles ---
enum Role {
  super_admin
  ceo
  admin
  operations_manager
  manager
  finance_officer
  receptionist
  office_boy
  member
}

// --------------------------------------------------------------- tenant ---
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String?
  phone     String?
  address   String?
  plan      String   @default("starter") // starter | growth | enterprise
  isActive  Boolean  @default(true) @map("is_active")
  logoPath  String?  @map("logo_path")
  primaryColor String? @map("primary_color")
  tagline   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         User[]
  buildings     Building[]
  floors        Floor[]
  zones         Zone[]
  units         Unit[]
  members       Member[]
  contracts     Contract[]
  membershipPlans MembershipPlan[]
  invoices      Invoice[]
  payments      Payment[]
  expenses      Expense[]
  attendance    AttendanceRecord[]
  leaves        Leave[]
  tasks         Task[]
  bookings      Booking[]
  notifications Notification[]
  tickets       Ticket[]
  ticketComments TicketComment[]
  visitors      Visitor[]
  maintenanceOrders MaintenanceOrder[]
  inventoryItems InventoryItem[]
  inventoryMovements InventoryMovement[]
  assets Asset[]
  documents Document[]
  creditNotes CreditNote[]
  refunds Refund[]
  rides Ride[]
  rideRequests RideRequest[]
  webhooks Webhook[]
  webhookDeliveries WebhookDelivery[]
  unitFavorites UnitFavorite[]
  emailSetting EmailSetting?
  settings      Setting[]
  auditLogs     AuditLog[]

  @@map("tenants")
}

// ----------------------------------------------------------------- user ---
model User {
  id           String  @id @default(cuid())
  tenantId     String? @map("tenant_id") // null => super_admin (global)
  tenant       Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String  @unique
  passwordHash String  @map("password_hash")
  role         Role    @default(member)
  phone        String?
  isActive     Boolean @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  totpSecret    String?  @map("totp_secret") // encrypted TOTP secret for 2FA
  totpEnabled   Boolean  @default(false) @map("totp_enabled")
  // Link for the member portal: a login that belongs to a Member record.
  memberId     String? @unique @map("member_id")
  member       Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  attendanceRecords AttendanceRecord[]
  leaves            Leave[]
  assignedTasks     Task[]         @relation("TaskAssignee")
  createdTasks      Task[]         @relation("TaskCreator")
  notifications     Notification[]
  auditLogs         AuditLog[]
  sessions          Session[]
  passwordResets    PasswordReset[]
  emailVerifications EmailVerification[]
  reportedTickets   Ticket[]        @relation("TicketReporter")
  assignedTickets   Ticket[]        @relation("TicketAssignee")
  ticketComments    TicketComment[]
  createdVisitors   Visitor[]
  assignedMaintenance MaintenanceOrder[]
  createdMaintenance  MaintenanceOrder[] @relation("MaintenanceCreator")
  inventoryMovements  InventoryMovement[]
  uploadedDocuments   Document[]
  createdCreditNotes  CreditNote[]
  requestedRefunds    Refund[] @relation("RefundRequester")
  processedRefunds    Refund[] @relation("RefundProcessor")
  offeredRides        Ride[]
  rideRequests        RideRequest[]
  unitFavorites       UnitFavorite[]

  @@index([tenantId, role])
  @@map("users")
}

// ---------------------------------------------------------------- space ---
model Building {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // e.g. "Gulberg Campus"
  address   String?
  city      String?
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  floors    Floor[]

  @@index([tenantId])
  @@map("buildings")
}

model Floor {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buildingId String?   @map("building_id")
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  name       String // e.g. "Ground Floor"
  level      Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  zones      Zone[]

  @@index([tenantId, buildingId])
  @@map("floors")
}

model Zone {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  floorId   String   @map("floor_id")
  floor     Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name      String // e.g. "Zone A"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  units     Unit[]

  @@map("zones")
}

enum UnitType {
  hot_desk
  dedicated_desk
  cabin
  meeting_room
  phone_booth
  virtual_office
  accommodation
}

enum UnitStatus {
  vacant
  occupied
  maintenance
}

model Unit {
  id           String     @id @default(cuid())
  tenantId     String     @map("tenant_id")
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zoneId       String     @map("zone_id")
  zone         Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  code         String // e.g. "HD-01" — unique per tenant
  type         UnitType
  status       UnitStatus @default(vacant)
  monthlyPrice Decimal    @map("monthly_price") @db.Decimal(12, 2)
  capacity     Int        @default(1)
  amenities    String[]   @default([])
  posX         Int        @default(0) @map("pos_x") // floor-plan grid X
  posY         Int        @default(0) @map("pos_y") // floor-plan grid Y
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  contracts Contract[]
  bookings  Booking[]
  tickets   Ticket[]
  maintenanceOrders MaintenanceOrder[]
  assets Asset[]
  favorites UnitFavorite[]

  @@unique([tenantId, code])
  @@index([tenantId, type, status])
  @@map("units")
}

// --------------------------------------------------------------- member ---
enum MemberStatus {
  active
  trial
  on_hold
  exited
}

model Member {
  id               String       @id @default(cuid())
  tenantId         String       @map("tenant_id")
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  phone            String
  cnic             String?
  companyName      String?      @map("company_name")
  emergencyContact String?      @map("emergency_contact")
  status           MemberStatus @default(active)
  notes            String?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user      User?
  contracts Contract[]
  invoices  Invoice[]
  bookings  Booking[]
  tickets   Ticket[]
  hostedVisits Visitor[]
  documents Document[]
  creditNotes CreditNote[]
  refunds Refund[]

  @@index([tenantId, status])
  @@map("members")
}

// -------------------------------------------------------- membership plan ---
model MembershipPlan {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String // e.g. "Hot Desk Monthly"
  description  String?
  price        Decimal   @db.Decimal(12, 2)
  billingCycle String    @default("monthly") @map("billing_cycle") // monthly | quarterly | yearly
  unitType     UnitType? @map("unit_type") // null = any unit type
  features     String[]  @default([])
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  contracts Contract[]

  @@index([tenantId, isActive])
  @@map("membership_plans")
}

// ------------------------------------------------------------- contract ---
enum ContractStatus {
  active
  expired
  cancelled
}

model Contract {
  id         String         @id @default(cuid())
  tenantId   String         @map("tenant_id")
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId   String         @map("member_id")
  member     Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  unitId     String         @map("unit_id")
  unit       Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  startDate  DateTime       @map("start_date") @db.Date
  endDate    DateTime?      @map("end_date") @db.Date
  rentAmount Decimal        @map("rent_amount") @db.Decimal(12, 2)
  status     ContractStatus @default(active)
  planId     String?        @map("plan_id")
  plan       MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  invoices Invoice[]

  @@index([tenantId, status])
  @@map("contracts")
}

// -------------------------------------------------------------- billing ---
enum InvoiceStatus {
  unpaid
  partial
  paid
  overdue
  cancelled
}

model Invoice {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId    String        @map("member_id")
  member      Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contractId  String?       @map("contract_id")
  contract    Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  number      String // e.g. INV-202610-0001 — unique per tenant
  periodStart DateTime      @map("period_start") @db.Date
  periodEnd   DateTime      @map("period_end") @db.Date
  dueDate     DateTime      @map("due_date") @db.Date
  amount      Decimal       @db.Decimal(12, 2)
  amountPaid  Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status      InvoiceStatus @default(unpaid)
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  payments Payment[]
  creditNotes CreditNote[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, memberId])
  @@map("invoices")
}

model Payment {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId String   @map("invoice_id")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  method    String // cash | bank_transfer | jazzcash | easypaisa | card
  receiptNo String?  @map("receipt_no")
  paidAt    DateTime @default(now()) @map("paid_at")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  refunds   Refund[]

  @@index([tenantId, invoiceId])
  @@map("payments")
}

// -------------------------------------------------------------- finance ---
model Expense {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    String // rent_building | utilities | internet | cleaning | kitchen | maintenance | marketing | salaries | petty_cash | other
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @db.Date
  paidBy      String?  @map("paid_by")
  note        String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId, date])
  @@map("expenses")
}

// ----------------------------------------------------------- attendance ---
model AttendanceRecord {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  checkIn   DateTime? @map("check_in")
  checkOut  DateTime? @map("check_out")
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, userId, date])
  @@map("attendance_records")
}

enum LeaveStatus {
  pending
  approved
  rejected
}

model Leave {
  id          String      @id @default(cuid())
  tenantId    String      @map("tenant_id")
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDate    DateTime    @map("from_date") @db.Date
  toDate      DateTime    @map("to_date") @db.Date
  reason      String?
  status      LeaveStatus @default(pending)
  decidedById String?     @map("decided_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("leaves")
}

// ---------------------------------------------------------------- tasks ---
enum TaskStatus {
  pending
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

model Task {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  assigneeId  String?      @map("assignee_id")
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String       @map("created_by_id")
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  status      TaskStatus   @default(pending)
  priority    TaskPriority @default(medium)
  dueDate     DateTime?    @map("due_date") @db.Date
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@map("tasks")
}

// -------------------------------------------------------------- booking ---
model Booking {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId      String    @map("unit_id")
  unit        Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  memberId    String?   @map("member_id")
  member      Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  title       String
  startAt     DateTime  @map("start_at")
  endAt       DateTime  @map("end_at")
  status      String    @default("confirmed") // confirmed | cancelled
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, unitId, startAt])
  @@map("bookings")
}

// -------------------------------------------------------- notifications ---
enum NotificationType {
  rent_due
  contract_expiry
  task_assigned
  general
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String           @map("tenant_id")
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?          @map("user_id")
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role? // when set, targets every active user with this role in the tenant
  type      NotificationType @default(general)
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([tenantId, userId, isRead])
  @@map("notifications")
}

// ---------------------------------------------------------------- ticket ---
enum TicketStatus {
  open
  in_progress
  on_hold
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

model Ticket {
  id           String         @id @default(cuid())
  tenantId     String         @map("tenant_id")
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketNumber Int            @map("ticket_number") // sequential per tenant
  title        String
  description  String?
  category     String         @default("general") // maintenance | billing | it | housekeeping | security | general
  priority     TicketPriority @default(medium)
  status       TicketStatus   @default(open)
  memberId     String?        @map("member_id")
  member       Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  reportedById String?        @map("reported_by_id")
  reportedBy   User?          @relation("TicketReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  assignedToId String?        @map("assigned_to_id")
  assignedTo   User?          @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  unitId       String?        @map("unit_id")
  unit         Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  dueDate      DateTime?      @map("due_date") @db.Date
  resolvedAt   DateTime?      @map("resolved_at")
  closedAt     DateTime?      @map("closed_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  comments TicketComment[]

  @@unique([tenantId, ticketNumber])
  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@map("tickets")
}

model TicketComment {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId  String   @map("ticket_id")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String?  @map("author_id")
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  isInternal Boolean @default(false) @map("is_internal") // staff-only note
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

// ---------------------------------------------------------------- visitor ---
model Visitor {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  email       String?
  cnic        String?
  purpose     String    @default("meeting") // meeting | tour | interview | delivery | other
  hostMemberId String?  @map("host_member_id")
  hostMember  Member?   @relation(fields: [hostMemberId], references: [id], onDelete: SetNull)
  hostName    String?   @map("host_name") // free text if no member record
  checkInAt   DateTime  @default(now()) @map("check_in_at")
  checkOutAt  DateTime? @map("check_out_at")
  badgeNo     String?   @map("badge_no")
  notes       String?
  createdById String?   @map("created_by_id")
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, checkInAt])
  @@map("visitors")
}

// ------------------------------------------------------------ maintenance ---
enum MaintenanceStatus {
  pending
  in_progress
  completed
  cancelled
}

model MaintenanceOrder {
  id           String            @id @default(cuid())
  tenantId     String            @map("tenant_id")
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNumber  Int               @map("order_number")
  title        String
  description  String?
  category     String            @default("general") // electrical | plumbing | hvac | furniture | it | cleaning | general
  priority     TicketPriority    @default(medium)
  status       MaintenanceStatus @default(pending)
  unitId       String?           @map("unit_id")
  unit         Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  assignedToId String?           @map("assigned_to_id")
  assignedTo   User?             @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  ticketId     String?           @map("ticket_id") // linked complaint ticket
  cost         Decimal?          @db.Decimal(12, 2)
  scheduledAt  DateTime?         @map("scheduled_at")
  completedAt  DateTime?         @map("completed_at")
  createdById  String?           @map("created_by_id")
  createdBy    User?             @relation("MaintenanceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@map("maintenance_orders")
}

// ------------------------------------------------------------ inventory ---
model InventoryItem {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  category    String   @default("general") // stationery | pantry | cleaning | it | furniture | general
  quantity    Int      @default(0)
  unit        String   @default("pcs") // pcs | boxes | liters | kg
  reorderLevel Int     @default(5) @map("reorder_level")
  unitPrice   Decimal? @map("unit_price") @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  movements InventoryMovement[]

  @@index([tenantId, category])
  @@map("inventory_items")
}

model InventoryMovement {
  id        String        @id @default(cuid())
  tenantId  String        @map("tenant_id")
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId    String        @map("item_id")
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      String // in | out | adjustment
  quantity  Int
  note      String?
  createdById String?     @map("created_by_id")
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([itemId, createdAt])
  @@map("inventory_movements")
}

// ----------------------------------------------------------------- assets ---
enum AssetStatus {
  active
  in_repair
  retired
  lost
}

model Asset {
  id          String      @id @default(cuid())
  tenantId    String      @map("tenant_id")
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  assetTag    String?     @map("asset_tag")
  category    String      @default("general") // furniture | it | appliance | vehicle | general
  status      AssetStatus @default(active)
  unitId      String?     @map("unit_id")
  unit        Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  purchaseDate DateTime?  @map("purchase_date") @db.Date
  purchaseCost Decimal?   @map("purchase_cost") @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@map("assets")
}

// --------------------------------------------------------------- documents ---
model Document {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  category    String   @default("general") // contract | id | invoice | policy | other
  memberId    String?  @map("member_id")
  member      Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  fileName    String?  @map("file_name")
  fileUrl     String?  @map("file_url")
  fileSize    Int?     @map("file_size")
  mimeType    String?  @map("mime_type")
  storagePath String?  @map("storage_path") // local disk path or S3 key
  notes       String?
  uploadedById String? @map("uploaded_by_id")
  uploadedBy  User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId, memberId])
  @@map("documents")
}

// ------------------------------------------------------------ credit notes ---
enum CreditNoteStatus {
  open
  applied
  cancelled
}

model CreditNote {
  id          String           @id @default(cuid())
  tenantId    String           @map("tenant_id")
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number      String // CN-202610-0001, unique per tenant
  memberId    String           @map("member_id")
  member      Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  invoiceId   String?          @map("invoice_id")
  invoice     Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount      Decimal          @db.Decimal(12, 2)
  amountUsed  Decimal          @default(0) @map("amount_used") @db.Decimal(12, 2)
  status      CreditNoteStatus @default(open)
  reason      String?
  createdById String?          @map("created_by_id")
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([tenantId, number])
  @@index([tenantId, memberId])
  @@map("credit_notes")
}

// ---------------------------------------------------------------- refunds ---
enum RefundStatus {
  pending
  approved
  rejected
  processed
}

model Refund {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number      String // RFD-202610-0001, unique per tenant
  paymentId   String?      @map("payment_id")
  payment     Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  memberId    String       @map("member_id")
  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount      Decimal      @db.Decimal(12, 2)
  reason      String?
  status      RefundStatus @default(pending)
  requestedById String?    @map("requested_by_id")
  requestedBy User?        @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  processedById String?    @map("processed_by_id")
  processedBy User?        @relation("RefundProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  processedAt DateTime?    @map("processed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("refunds")
}

// ------------------------------------------------------------------ rides ---
model Ride {
  id            String        @id @default(cuid())
  tenantId      String        @map("tenant_id")
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driverUserId  String?       @map("driver_user_id")
  driverUser    User?         @relation(fields: [driverUserId], references: [id], onDelete: SetNull)
  driverName    String        @map("driver_name")
  from          String
  to            String
  date          DateTime      @db.Date
  time          String
  seatsTotal    Int           @map("seats_total")
  seatsLeft     Int           @map("seats_left")
  car           String?
  phone         String?
  status        String        @default("open") // open | full | cancelled
  requests      RideRequest[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([tenantId, status, date])
  @@map("rides")
}

model RideRequest {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rideId          String   @map("ride_id")
  ride            Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  requesterUserId String?  @map("requester_user_id")
  requesterUser   User?    @relation(fields: [requesterUserId], references: [id], onDelete: SetNull)
  requesterName   String   @map("requester_name")
  status          String   @default("accepted") // accepted | cancelled
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([rideId, requesterUserId])
  @@index([tenantId, rideId])
  @@map("ride_requests")
}

// ---------------------------------------------------------------- webhooks ---
model Webhook {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  url       String
  events    String[] // e.g. ["booking.created","payment.received"]
  secret    String? // for HMAC signature
  active    Boolean  @default(true)
  deliveries WebhookDelivery[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, active])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookId    String   @map("webhook_id")
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  status       String   @default("pending") // pending | success | failed
  attempts     Int      @default(0)
  responseCode Int?     @map("response_code")
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, webhookId, createdAt])
  @@map("webhook_deliveries")
}

// ------------------------------------------------------- unit favorites ---
model UnitFavorite {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId    String   @map("unit_id")
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, unitId, userId])
  @@index([tenantId, userId])
  @@map("unit_favorites")
}

// ---------------------------------------------------------- email settings ---
model EmailSetting {
  id        String   @id @default(cuid())
  tenantId  String   @unique @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  host      String?
  port      Int      @default(587)
  secure    Boolean  @default(false)
  username  String?
  password  String? // encrypted at rest in future
  fromName  String?  @map("from_name")
  fromEmail String?  @map("from_email")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_settings")
}

// --------------------------------------------------------------- settings ---
model Setting {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@map("settings")
}

// --------------------------------------- phase 1: granular permissions ---
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "members.create"
  description String?
  module      String?  // e.g. "members", "finance", "tickets"
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

// --------------------------------------------- phase 1: audit logging ---
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?  @map("tenant_id") // null => platform-level action
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId   String?  @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String   // e.g. "member.update", "invoice.create"
  entity    String   // e.g. "Member"
  entityId  String?  @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// --------------------------------------- phase 1: sessions & password reset ---
model Session {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String  @map("refresh_hash") // hashed refresh token
  deviceInfo String?  @map("device_info")
  ip         String?
  expiresAt  DateTime @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_resets")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verifications")
}
