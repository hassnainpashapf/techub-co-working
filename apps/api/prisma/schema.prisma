// ------------------------------------------------- phase 41: procurement ---

model Vendor {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  company      String?
  email        String?
  phone        String?
  address      String?
  category     String   @default("other") // maintenance | food | it | office | other
  paymentTerms String   @default("net_30") @map("payment_terms") // net_15 | net_30 | cod
  taxId        String?  @map("tax_id")
  rating       Decimal? @db.Decimal(3, 2) @map("rating") // 0.00 - 5.00, auto-computed
  isActive     Boolean  @default(true) @map("is_active")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  purchaseOrders PurchaseOrder[]
  vendorBills    VendorBill[]
  contracts      VendorContract[]
  ratings        VendorRating[] @relation("VendorRatings")

  @@index([tenantId, isActive])
  @@index([tenantId, category])
  @@map("vendors")
}

// ------------------------------------------------------- Phase 42: HR ----
// HR & Payroll Pro Pack — employee management, attendance, leaves, overtime,
// performance reviews, advances/loans, onboarding, exits, HR docs.

model Employee {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId           String?  @unique @map("user_id") // linked login (User)
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name             String
  email            String?
  phone            String?
  department       String   @default("ops") // ops | finance | sales | admin | support
  designation      String   @default("Staff")
  joiningDate      DateTime @default(now()) @map("joining_date")
  employmentType   String   @default("full_time") @map("employment_type") // full_time | part_time | contract
  status           String   @default("active") // active | on_leave | exited
  emergencyContact String?  @map("emergency_contact")
  cnic             String?
  address          String?
  createdAt        DateTime @default(now()) @map("created_at")

  staffAttendance    StaffAttendance[]
  leaveBalances      LeaveBalance[]
  overtime           Overtime[]
  performanceReviews PerformanceReview[]  @relation("ReviewEmployee")
  salaryAdvances     SalaryAdvance[]
  onboardings        EmployeeOnboarding[]
  exits              EmployeeExit[]
  documents          Document[]
  // Phase 43: Cafeteria & F&B Pack
  cafeStaff          CafeStaff?

  @@index([tenantId, status])
  @@index([tenantId, department])
  @@map("employees")
}

model StaffAttendance {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId    String   @map("employee_id")
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime @map("date") // attendance day (midnight UTC)
  checkIn       DateTime? @map("check_in")
  checkOut      DateTime? @map("check_out")
  status        String   @default("present") @map("status") // present | late | absent | half_day | on_leave
  lateMinutes   Int?     @map("late_minutes")
  workedMinutes Int?     @map("worked_minutes")
  note          String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])
  @@index([employeeId, date])
  @@map("staff_attendance")
}

model LeaveBalance {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year       Int
  type       String   @default("annual") // annual | sick | casual | unpaid
  allocated  Int      @default(0)
  used       Int      @default(0) @map("used")

  @@unique([tenantId, employeeId, year, type])
  @@index([tenantId, year])
  @@map("leave_balances")
}

model Overtime {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String   @map("employee_id")
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  minutes     Int
  reason      String
  status      String   @default("pending") // pending | approved | rejected
  requestedAt DateTime @default(now()) @map("requested_at")
  decidedBy   String?  @map("decided_by")
  decider     User?    @relation("OvertimeDecided", fields: [decidedBy], references: [id], onDelete: SetNull)
  decidedAt   DateTime? @map("decided_at")

  @@unique([employeeId, date])
  @@index([tenantId, status])
  @@index([tenantId, date])
  @@map("overtime")
}

model PerformanceReview {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId   String   @map("employee_id")
  employee     Employee @relation("ReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  period       String   // e.g. "2026-Q3"
  reviewerId   String   @map("reviewer_id")
  reviewer     User     @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  ratings      Json     // { punctuality: 4, quality: 5, teamwork: 4 }
  overall      Decimal? @db.Decimal(3, 1)
  strengths    String?
  improvements String?
  goals        String?
  status       String   @default("draft") // draft | submitted | acknowledged
  submittedAt  DateTime? @map("submitted_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, employeeId, period])
  @@index([tenantId, employeeId])
  @@index([tenantId, period])
  @@index([tenantId, status])
  @@map("performance_reviews")
}

model SalaryAdvance {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId        String    @map("employee_id")
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount            Decimal   @db.Decimal(12, 2)
  type              String    @default("advance") // advance | loan
  installments      Int       @default(1)
  installmentAmount Decimal   @default(0) @map("installment_amount") @db.Decimal(12, 2)
  deductedSoFar     Decimal   @default(0) @map("deducted_so_far") @db.Decimal(12, 2)
  status            String    @default("pending") // pending | approved | rejected | deducting | closed
  reason            String?
  requestedAt       DateTime  @default(now()) @map("requested_at")
  decidedById       String?   @map("decided_by_id")
  decidedBy         User?     @relation("AdvanceDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt         DateTime? @map("decided_at")
  decideNote        String?   @map("decide_note")
  createdAt         DateTime  @default(now()) @map("created_at")

  deductions AdvanceDeduction[]

  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@map("salary_advances")
}

model AdvanceDeduction {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  advanceId  String   @map("advance_id")
  advance    SalaryAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  payslipId  String?  @map("payslip_id") // linked payslip (plain id, no FK)
  amount     Decimal  @db.Decimal(12, 2)
  deductedAt DateTime @default(now()) @map("deducted_at")

  @@index([tenantId, advanceId])
  @@index([advanceId])
  @@map("advance_deductions")
}

model OnboardingTemplate {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  tasks     Json     // [{ title, dept, dayOffset }]
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  onboardings EmployeeOnboarding[]

  @@index([tenantId])
  @@map("onboarding_templates")
}

model EmployeeOnboarding {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  templateId  String?   @map("template_id")
  template    OnboardingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items       Json      // [{ title, dept, dayOffset, done, doneBy, doneAt }]
  status      String    @default("in_progress") // in_progress | completed
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([tenantId, status])
  @@index([employeeId])
  @@map("employee_onboardings")
}

model EmployeeExit {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId      String    @map("employee_id")
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type            String    // resignation | termination
  lastWorkingDay  DateTime  @map("last_working_day")
  reason          String?
  noticeDays      Int?      @map("notice_days")
  clearanceItems  Json      @default("[]") @map("clearance_items")
  status          String    @default("initiated") // initiated | clearance_pending | completed
  initiatedBy     String    @map("initiated_by")
  initiator       User      @relation("ExitInitiator", fields: [initiatedBy], references: [id], onDelete: Restrict)
  initiatedAt     DateTime  @default(now()) @map("initiated_at")
  completedAt     DateTime? @map("completed_at")

  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@map("employee_exits")
}

model PurchaseOrder {
  id          String  @id @default(cuid())
  tenantId    String  @map("tenant_id")
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number      String // PO-YYYYMM-NNNN series, unique per tenant
  vendorId    String  @map("vendor_id")
  vendor      Vendor  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items       Json // [{ desc, qty, price }]
  subtotal    Decimal @db.Decimal(12, 2)
  tax         Decimal @db.Decimal(12, 2) @default(0)
  total       Decimal @db.Decimal(12, 2)
  status      String  @default("draft") // draft | pending_approval | approved | rejected | ordered | received | closed
  requestedBy String? @map("requested_by")
  requester   User?   @relation("PORequester", fields: [requestedBy], references: [id], onDelete: SetNull)
  approvedBy  String? @map("approved_by")
  approver    User?   @relation("POApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  notes       String? @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  approvals     POApproval[]
  goodsReceipts GoodsReceipt[] @relation("PurchaseOrderGoodsReceipts")
  vendorBills   VendorBill[]

  @@unique([tenantId, number])
  @@index([tenantId, vendorId])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model POApproval {
  id         String        @id @default(cuid())
  tenantId   String        @map("tenant_id")
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  poId       String        @map("po_id")
  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  approverId String        @map("approver_id")
  approver   User          @relation("POApprovalApprover", fields: [approverId], references: [id], onDelete: Cascade)
  decision   String // approved | rejected
  note       String?       @db.Text
  level      Int           @default(1) // approval level: 1 = manager/admin, 2 = ceo
  required   Boolean       @default(true)
  decidedAt  DateTime      @default(now()) @map("decided_at")

  @@unique([tenantId, poId, level])
  @@index([tenantId, poId])
  @@map("po_approvals")
}

model GoodsReceipt {
  id            String        @id @default(cuid())
  tenantId      String        @map("tenant_id")
  tenant        Tenant        @relation("TenantGoodsReceipts", fields: [tenantId], references: [id], onDelete: Cascade)
  poId          String        @map("po_id")
  purchaseOrder PurchaseOrder @relation("PurchaseOrderGoodsReceipts", fields: [poId], references: [id], onDelete: Cascade)
  receivedBy    String?       @map("received_by")
  receiver      User?         @relation("UserGoodsReceiptsReceived", fields: [receivedBy], references: [id], onDelete: SetNull)
  receivedAt    DateTime      @default(now()) @map("received_at")
  itemsReceived Json          @map("items_received") // [{ desc, orderedQty, receivedQty, condition }]
  discrepancies String?
  status        String        @default("complete") // complete | partial
  createdAt     DateTime      @default(now()) @map("created_at")

  vendorBills VendorBill[]

  @@index([tenantId])
  @@index([poId])
  @@map("goods_receipts")
}

model VendorBill {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billNo        String         @map("bill_no") // vendor ka apna invoice number
  vendorId      String         @map("vendor_id")
  vendor        Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  poId          String?        @map("po_id")
  purchaseOrder PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  grnId         String?        @map("grn_id")
  goodsReceipt  GoodsReceipt?  @relation(fields: [grnId], references: [id], onDelete: SetNull)
  amount        Decimal        @db.Decimal(12, 2)
  paidAmount    Decimal        @default(0) @db.Decimal(12, 2) @map("paid_amount") // partial-payment tracking
  dueDate       DateTime       @db.Date @map("due_date")
  status        String         @default("pending") @map("status") // pending | approved | paid | disputed (overdue derived)
  disputeReason String?        @map("dispute_reason") @db.Text
  paidAt        DateTime?      @map("paid_at")
  expenseId     String?        @map("expense_id") // approve par bani Expense entry ka id (no FK)
  approvedBy    String?        @map("approved_by")
  approver      User?          @relation("VendorBillApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  notes         String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  payments VendorPayment[]

  @@index([tenantId, status])
  @@index([tenantId, vendorId])
  @@index([tenantId, dueDate])
  @@map("vendor_bills")
}

model VendorPayment {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billId    String   @map("bill_id")
  bill      VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  method    String   @default("bank") // bank | cash | online
  reference String?
  paidAt    DateTime @default(now()) @map("paid_at")
  paidById  String   @map("paid_by_id")
  paidBy    User     @relation("VendorPaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, billId])
  @@index([tenantId, paidAt])
  @@map("vendor_payments")
}

model VendorRating {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation("TenantVendorRatings", fields: [tenantId], references: [id], onDelete: Cascade)
  vendorId  String   @map("vendor_id")
  vendor    Vendor   @relation("VendorRatings", fields: [vendorId], references: [id], onDelete: Cascade)
  ratedBy   String   @map("rated_by")
  rater     User     @relation("UserVendorRatings", fields: [ratedBy], references: [id], onDelete: Cascade)
  score     Int // 1-5
  criteria  String   @default("quality") // quality | timeliness | price
  comment   String?  @db.Text
  ratedAt   DateTime @default(now()) @map("rated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([vendorId, ratedBy])
  @@index([tenantId, vendorId])
  @@map("vendor_ratings")
}

model VendorContract {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendorId        String    @map("vendor_id")
  vendor          Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  title           String
  startDate       DateTime? @map("start_date")
  endDate         DateTime  @map("end_date")
  value           Decimal?  @db.Decimal(12, 2)
  autoRenew       Boolean   @default(false) @map("auto_renew")
  documentUrl     String?   @map("document_url")
  reminderDays    Int       @default(30) @map("reminder_days")
  status          String    @default("active") @map("status") // active | expired
  lastReminderKey String?   @map("last_reminder_key")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, endDate])
  @@map("vendor_contracts")
}

// ------------------------------------------------- Phase 43: Cafeteria & F&B Pack ---
model MenuCategory {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  MenuItem[]

  @@index([tenantId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  categoryId  String   @map("category_id")
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?  @map("image_url")
  isAvailable Boolean  @default(true) @map("is_available")
  tags        Json     @default("[]") // e.g. ["veg", "spicy"]
  prepTimeMin Int?     @map("prep_time_min")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  ratings  FoodRating[]
  wasteLogs FoodWaste[]

  @@index([tenantId, categoryId])
  @@index([tenantId, isAvailable])
  @@map("menu_items")
}

model FoodOrder {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId     String    @map("member_id")
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // items: [{ menuItemId?, name, qty, price }] — price snapshot at order time
  items        Json      @map("items")
  subtotal     Decimal   @db.Decimal(12, 2) @map("subtotal")
  // pending -> preparing -> ready -> delivered ; cancelled from pending/preparing
  status       String    @default("pending") @map("status")
  deliveryZone String?   @map("delivery_zone")
  note         String?   @map("note")
  orderedAt    DateTime  @default(now()) @map("ordered_at")
  readyAt      DateTime? @map("ready_at")
  deliveredAt  DateTime? @map("delivered_at")
  // Phase 43 Track 4: payment fields (delta, no duplicate model)
  paymentStatus String    @default("unpaid") @map("payment_status") // unpaid | paid | added_to_invoice
  paymentMethod String?   @map("payment_method") // cash | card | wallet | invoice
  paidAt        DateTime? @map("paid_at")
  invoiceId     String?   @map("invoice_id") // 'invoice' method par bana Invoice

  @@index([tenantId, memberId])
  @@index([tenantId, status])
  @@index([tenantId, paymentStatus])
  @@map("food_orders")
}

model DeliveryZone {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String // e.g. "Floor 1", "Meeting Room A", "Outdoor Patio"
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sortOrder])
  @@index([tenantId, isActive])
  @@map("delivery_zones")
}

model MealPlan {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String // e.g. "Monthly Lunch"
  description String?
  price       Decimal  @db.Decimal(12, 2)
  mealsPerDay Int      @default(1) @map("meals_per_day")
  validDays   Int      @default(30) @map("valid_days") // plan duration in days
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions MemberMealPlan[]

  @@index([tenantId, isActive])
  @@map("meal_plans")
}

model MemberMealPlan {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  memberId   String   @map("member_id")
  planId     String   @map("plan_id")
  startDate  DateTime @map("start_date")
  endDate    DateTime @map("end_date")
  mealsUsed  Int      @default(0) @map("meals_used")
  mealsTotal Int      @map("meals_total")
  status     String   @default("active") // active | expired | cancelled
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan   MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([tenantId, memberId])
  @@index([tenantId, status])
  @@map("member_meal_plans")
}

model FoodRating {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  menuItemId String   @map("menu_item_id")
  memberId   String   @map("member_id")
  score      Int // 1..5
  comment    String?
  ratedAt    DateTime @default(now()) @map("rated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, memberId]) // ek member ek item ko ek dafa rate karta hai (dobara = update)
  @@index([tenantId, menuItemId])
  @@index([tenantId, memberId])
  @@map("food_ratings")
}

model CafeStaff {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String   @unique @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role       String   // chef | cashier | runner
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, isActive])
  @@index([tenantId, role])
  @@map("cafe_staff")
}

model FoodWaste {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  date         DateTime  @db.Date
  menuItemId   String?   @map("menu_item_id")
  description  String
  quantity     Int
  reason       String    @default("spoiled") // spoiled | overcooked | expired | other
  costEstimate Decimal?  @map("cost_estimate") @db.Decimal(12, 2)
  recordedById String    @map("recorded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  recordedBy User      @relation("FoodWasteLogged", fields: [recordedById], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([tenantId, reason])
  @@map("food_waste")
}

// ----------------------------------------------------------------- Phase 45: AI & Intelligence Pack
model AiSetting {
  id                  String  @id @default(cuid())
  tenantId            String  @unique @map("tenant_id")
  tenant              Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider            String  @default("disabled") // disabled | openai | anthropic | openai-compatible
  apiKeyEncrypted     String? @map("api_key_encrypted") // AES-256-GCM, write-only
  baseUrl             String? @map("base_url") // custom base URL (openai-compatible only, https enforced)
  model               String? // e.g. gpt-4o-mini, claude-3-5-haiku
  enabledFeatures     Json?   @map("enabled_features") // { chat: true, insights: true, sentiment: true }
  monthlyTokenCap     Int?    @map("monthly_token_cap")
  tokensUsedThisMonth Int     @default(0) @map("tokens_used_this_month")
  usageMonth          String  @default("") @map("usage_month") // YYYY-MM, resets when month changes
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("ai_settings")
}

model Insight {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  week      DateTime @map("week") @db.Date
  type      String   // revenue | occupancy | churn | billing | leases
  title     String
  body      String   @db.Text
  severity  String   @default("info") @map("severity") // info | warning | critical
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, week, type])
  @@index([tenantId, week])
  @@index([tenantId, isRead])
  @@map("insights")
}
