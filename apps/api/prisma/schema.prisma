// Coworking SaaS — multi-tenant data model (MVP)
// Every business table carries tenantId. The `super_admin` role has tenantId = null (global).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- roles ---
enum Role {
  super_admin
  ceo
  admin
  operations_manager
  manager
  finance_officer
  receptionist
  office_boy
  member
}

// --------------------------------------------------------------- tenant ---
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String?
  phone     String?
  address   String?
  plan      String   @default("starter") // starter | growth | enterprise
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         User[]
  buildings     Building[]
  floors        Floor[]
  zones         Zone[]
  units         Unit[]
  members       Member[]
  contracts     Contract[]
  invoices      Invoice[]
  payments      Payment[]
  expenses      Expense[]
  attendance    AttendanceRecord[]
  leaves        Leave[]
  tasks         Task[]
  bookings      Booking[]
  notifications Notification[]
  settings      Setting[]

  @@map("tenants")
}

// ----------------------------------------------------------------- user ---
model User {
  id           String  @id @default(cuid())
  tenantId     String? @map("tenant_id") // null => super_admin (global)
  tenant       Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String  @unique
  passwordHash String  @map("password_hash")
  role         Role    @default(member)
  phone        String?
  isActive     Boolean @default(true) @map("is_active")
  // Link for the member portal: a login that belongs to a Member record.
  memberId     String? @unique @map("member_id")
  member       Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  attendanceRecords AttendanceRecord[]
  leaves            Leave[]
  assignedTasks     Task[]         @relation("TaskAssignee")
  createdTasks      Task[]         @relation("TaskCreator")
  notifications     Notification[]

  @@index([tenantId, role])
  @@map("users")
}

// ---------------------------------------------------------------- space ---
model Building {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // e.g. "Gulberg Campus"
  address   String?
  city      String?
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  floors    Floor[]

  @@index([tenantId])
  @@map("buildings")
}

model Floor {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buildingId String?   @map("building_id")
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  name       String // e.g. "Ground Floor"
  level      Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  zones      Zone[]

  @@index([tenantId, buildingId])
  @@map("floors")
}

model Zone {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  floorId   String   @map("floor_id")
  floor     Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name      String // e.g. "Zone A"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  units     Unit[]

  @@map("zones")
}

enum UnitType {
  hot_desk
  dedicated_desk
  cabin
  meeting_room
  phone_booth
}

enum UnitStatus {
  vacant
  occupied
  maintenance
}

model Unit {
  id           String     @id @default(cuid())
  tenantId     String     @map("tenant_id")
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zoneId       String     @map("zone_id")
  zone         Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  code         String // e.g. "HD-01" — unique per tenant
  type         UnitType
  status       UnitStatus @default(vacant)
  monthlyPrice Decimal    @map("monthly_price") @db.Decimal(12, 2)
  capacity     Int        @default(1)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  contracts Contract[]
  bookings  Booking[]

  @@unique([tenantId, code])
  @@index([tenantId, type, status])
  @@map("units")
}

// --------------------------------------------------------------- member ---
enum MemberStatus {
  active
  trial
  on_hold
  exited
}

model Member {
  id               String       @id @default(cuid())
  tenantId         String       @map("tenant_id")
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  phone            String
  cnic             String?
  companyName      String?      @map("company_name")
  emergencyContact String?      @map("emergency_contact")
  status           MemberStatus @default(active)
  notes            String?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user      User?
  contracts Contract[]
  invoices  Invoice[]
  bookings  Booking[]

  @@index([tenantId, status])
  @@map("members")
}

// ------------------------------------------------------------- contract ---
enum ContractStatus {
  active
  expired
  cancelled
}

model Contract {
  id         String         @id @default(cuid())
  tenantId   String         @map("tenant_id")
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId   String         @map("member_id")
  member     Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  unitId     String         @map("unit_id")
  unit       Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  startDate  DateTime       @map("start_date") @db.Date
  endDate    DateTime?      @map("end_date") @db.Date
  rentAmount Decimal        @map("rent_amount") @db.Decimal(12, 2)
  status     ContractStatus @default(active)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  invoices Invoice[]

  @@index([tenantId, status])
  @@map("contracts")
}

// -------------------------------------------------------------- billing ---
enum InvoiceStatus {
  unpaid
  partial
  paid
  overdue
  cancelled
}

model Invoice {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId    String        @map("member_id")
  member      Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contractId  String?       @map("contract_id")
  contract    Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  number      String // e.g. INV-202610-0001 — unique per tenant
  periodStart DateTime      @map("period_start") @db.Date
  periodEnd   DateTime      @map("period_end") @db.Date
  dueDate     DateTime      @map("due_date") @db.Date
  amount      Decimal       @db.Decimal(12, 2)
  amountPaid  Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status      InvoiceStatus @default(unpaid)
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  payments Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, memberId])
  @@map("invoices")
}

model Payment {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId String   @map("invoice_id")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  method    String // cash | bank_transfer | jazzcash | easypaisa | card
  receiptNo String?  @map("receipt_no")
  paidAt    DateTime @default(now()) @map("paid_at")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, invoiceId])
  @@map("payments")
}

// -------------------------------------------------------------- finance ---
model Expense {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    String // rent_building | utilities | internet | cleaning | kitchen | maintenance | marketing | salaries | petty_cash | other
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @db.Date
  paidBy      String?  @map("paid_by")
  note        String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId, date])
  @@map("expenses")
}

// ----------------------------------------------------------- attendance ---
model AttendanceRecord {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  checkIn   DateTime? @map("check_in")
  checkOut  DateTime? @map("check_out")
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, userId, date])
  @@map("attendance_records")
}

enum LeaveStatus {
  pending
  approved
  rejected
}

model Leave {
  id          String      @id @default(cuid())
  tenantId    String      @map("tenant_id")
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDate    DateTime    @map("from_date") @db.Date
  toDate      DateTime    @map("to_date") @db.Date
  reason      String?
  status      LeaveStatus @default(pending)
  decidedById String?     @map("decided_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("leaves")
}

// ---------------------------------------------------------------- tasks ---
enum TaskStatus {
  pending
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

model Task {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  assigneeId  String?      @map("assignee_id")
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String       @map("created_by_id")
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  status      TaskStatus   @default(pending)
  priority    TaskPriority @default(medium)
  dueDate     DateTime?    @map("due_date") @db.Date
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@map("tasks")
}

// -------------------------------------------------------------- booking ---
model Booking {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId      String    @map("unit_id")
  unit        Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  memberId    String?   @map("member_id")
  member      Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  title       String
  startAt     DateTime  @map("start_at")
  endAt       DateTime  @map("end_at")
  status      String    @default("confirmed") // confirmed | cancelled
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, unitId, startAt])
  @@map("bookings")
}

// -------------------------------------------------------- notifications ---
enum NotificationType {
  rent_due
  contract_expiry
  task_assigned
  general
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String           @map("tenant_id")
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?          @map("user_id")
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role? // when set, targets every active user with this role in the tenant
  type      NotificationType @default(general)
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([tenantId, userId, isRead])
  @@map("notifications")
}

// --------------------------------------------------------------- settings ---
model Setting {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@map("settings")
}
