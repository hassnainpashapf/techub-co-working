// Coworking SaaS — multi-tenant data model (MVP)
// Every business table carries tenantId. The `super_admin` role has tenantId = null (global).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- roles ---
enum Role {
  super_admin
  ceo
  admin
  operations_manager
  manager
  finance_officer
  receptionist
  office_boy
  member
}

// --------------------------------------------------------------- tenant ---
model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  email        String?
  phone        String?
  address      String?
  plan         String   @default("starter") // starter | growth | enterprise
  isActive     Boolean  @default(true) @map("is_active")
  logoPath     String?  @map("logo_path")
  primaryColor String?  @map("primary_color")
  tagline      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users                   User[]
  buildings               Building[]
  floors                  Floor[]
  zones                   Zone[]
  units                   Unit[]
  members                 Member[]
  contracts               Contract[]
  membershipPlans         MembershipPlan[]
  invoices                Invoice[]
  payments                Payment[]
  expenses                Expense[]
  attendance              AttendanceRecord[]
  leaves                  Leave[]
  tasks                   Task[]
  bookings                Booking[]
  notifications           Notification[]
  tickets                 Ticket[]
  ticketComments          TicketComment[]
  visitors                Visitor[]
  maintenanceOrders       MaintenanceOrder[]
  inventoryItems          InventoryItem[]
  inventoryMovements      InventoryMovement[]
  assets                  Asset[]
  documents               Document[]
  creditNotes             CreditNote[]
  refunds                 Refund[]
  rides                   Ride[]
  rideRequests            RideRequest[]
  webhooks                Webhook[]
  webhookDeliveries       WebhookDelivery[]
  unitFavorites           UnitFavorite[]
  companies               Company[]
  apiKeys                 ApiKey[]
  emailSetting            EmailSetting?
  settings                Setting[]
  auditLogs               AuditLog[]
  subscription            TenantSubscription?
  smsLogs                 SmsLog[]
  whatsappLogs            WhatsappLog[]
  announcements           Announcement[]
  notificationPreferences NotificationPreference[]
  jobs                    Job[]
  recurringBookings       RecurringBooking[]
  leads                   Lead[]
  feedback                Feedback[]
  emailTemplates          EmailTemplate[]
  savedViews              SavedView[]
  bookingRequests         BookingRequest[]
  salaryStructures        SalaryStructure[]
  payrollRuns             PayrollRun[]
  recurringInvoices       RecurringInvoice[]
  dunningLogs             DunningLog[]
  onlinePayments          OnlinePayment[]
  budgets                 Budget[]
  pettyCashTransactions   PettyCashTransaction[]
  loginAlerts             LoginAlert[]
  auditArchives           AuditArchive[]
  backupRecords           BackupRecord[]
  communityEvents         CommunityEvent[]
  referralCodes           ReferralCode[]
  referrals               Referral[]
  loyaltyLedger           LoyaltyLedger[]
  marketplaceListings     MarketplaceListing[]
  surveys                 Survey[]
  visitorInvites          VisitorInvite[]

  @@map("tenants")
}

// ----------------------------------------------------------------- user ---
model User {
  id              String    @id @default(cuid())
  tenantId        String?   @map("tenant_id") // null => super_admin (global)
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  email           String    @unique
  passwordHash    String    @map("password_hash")
  role            Role      @default(member)
  phone           String?
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  totpSecret      String?   @map("totp_secret") // encrypted TOTP secret for 2FA
  totpEnabled     Boolean   @default(false) @map("totp_enabled")
  // Link for the member portal: a login that belongs to a Member record.
  memberId        String?   @unique @map("member_id")
  member          Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  attendanceRecords       AttendanceRecord[]
  leaves                  Leave[]
  assignedTasks           Task[]                   @relation("TaskAssignee")
  createdTasks            Task[]                   @relation("TaskCreator")
  notifications           Notification[]
  auditLogs               AuditLog[]
  sessions                Session[]
  passwordResets          PasswordReset[]
  emailVerifications      EmailVerification[]
  reportedTickets         Ticket[]                 @relation("TicketReporter")
  assignedTickets         Ticket[]                 @relation("TicketAssignee")
  ticketComments          TicketComment[]
  createdVisitors         Visitor[]
  assignedMaintenance     MaintenanceOrder[]
  createdMaintenance      MaintenanceOrder[]       @relation("MaintenanceCreator")
  inventoryMovements      InventoryMovement[]
  uploadedDocuments       Document[]
  createdCreditNotes      CreditNote[]
  requestedRefunds        Refund[]                 @relation("RefundRequester")
  processedRefunds        Refund[]                 @relation("RefundProcessor")
  offeredRides            Ride[]
  rideRequests            RideRequest[]
  unitFavorites           UnitFavorite[]
  sentAnnouncements       Announcement[]           @relation("SentAnnouncements")
  notificationPreferences NotificationPreference[]
  assignedLeads           Lead[]                   @relation("LeadAssignee")
  savedViews              SavedView[]
  salaryStructures        SalaryStructure[]        @relation("SalaryStructures")
  payslips                Payslip[]                @relation("Payslips")
  pettyCashTransactions   PettyCashTransaction[]
  refreshTokens           RefreshToken[]
  userSessions            UserSession[]
  loginAlerts             LoginAlert[]
  createdEvents           CommunityEvent[]         @relation("EventCreator")
  pushSubscriptions       PushSubscription[]
  announcementReads       AnnouncementRead[]       @relation("AnnouncementReads")

  @@index([tenantId, role])
  @@map("users")
}

// ---------------------------------------------------------------- space ---
model Building {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // e.g. "Gulberg Campus"
  address   String?
  city      String?
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  floors    Floor[]

  @@index([tenantId])
  @@map("buildings")
}

model Floor {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buildingId String?   @map("building_id")
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  name       String // e.g. "Ground Floor"
  level      Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  zones      Zone[]

  @@index([tenantId, buildingId])
  @@map("floors")
}

model Zone {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  floorId   String   @map("floor_id")
  floor     Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name      String // e.g. "Zone A"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  units     Unit[]

  @@map("zones")
}

enum UnitType {
  hot_desk
  dedicated_desk
  cabin
  meeting_room
  phone_booth
  virtual_office
  accommodation
}

enum UnitStatus {
  vacant
  occupied
  maintenance
}

model Unit {
  id           String     @id @default(cuid())
  tenantId     String     @map("tenant_id")
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zoneId       String     @map("zone_id")
  zone         Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  code         String // e.g. "HD-01" — unique per tenant
  type         UnitType
  status       UnitStatus @default(vacant)
  monthlyPrice Decimal    @map("monthly_price") @db.Decimal(12, 2)
  capacity     Int        @default(1)
  amenities    String[]   @default([])
  posX         Int        @default(0) @map("pos_x") // floor-plan grid X
  posY         Int        @default(0) @map("pos_y") // floor-plan grid Y
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  contracts         Contract[]
  bookings          Booking[]
  tickets           Ticket[]
  maintenanceOrders MaintenanceOrder[]
  assets            Asset[]
  favorites         UnitFavorite[]

  recurringBookings RecurringBooking[]
  bookingRequests   BookingRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, type, status])
  @@map("units")
}

// --------------------------------------------------------------- member ---
enum MemberStatus {
  active
  trial
  on_hold
  exited
}

model Member {
  id               String       @id @default(cuid())
  tenantId         String       @map("tenant_id")
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  phone            String
  cnic             String?
  companyName      String?      @map("company_name")
  emergencyContact String?      @map("emergency_contact")
  status           MemberStatus @default(active)
  notes            String?
  creditLimit      Decimal?     @map("credit_limit") @db.Decimal(12, 2) // null = unlimited
  directoryOptIn   Boolean      @default(false) @map("directory_opt_in")
  directoryBio     String?      @map("directory_bio")
  directoryTags    String[]     @default([]) @map("directory_tags")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  user         User?
  contracts    Contract[]
  invoices     Invoice[]
  bookings     Booking[]
  tickets      Ticket[]
  hostedVisits Visitor[]
  documents    Document[]
  creditNotes  CreditNote[]
  refunds      Refund[]

  recurringBookings   RecurringBooking[]
  leadConversions     Lead[]               @relation("LeadConversion")
  feedback            Feedback[]
  recurringInvoices   RecurringInvoice[]
  eventRsvps          EventRsvp[]
  referralCodes       ReferralCode[]       @relation("MemberReferralCodes")
  loyaltyLedger       LoyaltyLedger[]
  marketplaceListings MarketplaceListing[]
  surveyResponses     SurveyResponse[]
  surveyInvites       SurveyInvite[]
  visitorInvites      VisitorInvite[]

  @@index([tenantId, status])
  @@map("members")
}

// ------------------------------------------------------------ company ------
model Company {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  industry  String?
  email     String?
  phone     String?
  address   String?
  website   String?
  logoPath  String?  @map("logo_path")
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members Member[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("companies")
}

// -------------------------------------------------------- membership plan ---
model MembershipPlan {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String // e.g. "Hot Desk Monthly"
  description  String?
  price        Decimal   @db.Decimal(12, 2)
  billingCycle String    @default("monthly") @map("billing_cycle") // monthly | quarterly | yearly
  unitType     UnitType? @map("unit_type") // null = any unit type
  features     String[]  @default([])
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  contracts Contract[]

  @@index([tenantId, isActive])
  @@map("membership_plans")
}

// ------------------------------------------------------------- contract ---
enum ContractStatus {
  active
  expired
  cancelled
}

model Contract {
  id         String          @id @default(cuid())
  tenantId   String          @map("tenant_id")
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId   String          @map("member_id")
  member     Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  unitId     String          @map("unit_id")
  unit       Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  startDate  DateTime        @map("start_date") @db.Date
  endDate    DateTime?       @map("end_date") @db.Date
  rentAmount Decimal         @map("rent_amount") @db.Decimal(12, 2)
  status     ContractStatus  @default(active)
  planId     String?         @map("plan_id")
  plan       MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  invoices Invoice[]

  @@index([tenantId, status])
  @@map("contracts")
}

// -------------------------------------------------------------- billing ---
enum InvoiceStatus {
  unpaid
  partial
  paid
  overdue
  cancelled
}

model Invoice {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId    String        @map("member_id")
  member      Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contractId  String?       @map("contract_id")
  contract    Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  number      String // e.g. INV-202610-0001 — unique per tenant
  periodStart DateTime      @map("period_start") @db.Date
  periodEnd   DateTime      @map("period_end") @db.Date
  dueDate     DateTime      @map("due_date") @db.Date
  amount      Decimal       @db.Decimal(12, 2)
  amountPaid  Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  status      InvoiceStatus @default(unpaid)
  invoiceType String        @default("standard") @map("invoice_type") // standard | proforma
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  payments       Payment[]
  creditNotes    CreditNote[]
  dunningLogs    DunningLog[]
  onlinePayments OnlinePayment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, memberId])
  @@index([tenantId, invoiceType])
  @@map("invoices")
}

model Payment {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId String   @map("invoice_id")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  method    String // cash | bank_transfer | jazzcash | easypaisa | card
  receiptNo String?  @map("receipt_no")
  paidAt    DateTime @default(now()) @map("paid_at")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  refunds   Refund[]

  @@index([tenantId, invoiceId])
  @@map("payments")
}

// -------------------------------------------------------------- finance ---
model Expense {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    String // rent_building | utilities | internet | cleaning | kitchen | maintenance | marketing | salaries | petty_cash | other
  amount      Decimal   @db.Decimal(12, 2)
  date        DateTime  @db.Date
  paidBy      String?   @map("paid_by")
  note        String?
  createdById String?   @map("created_by_id")
  status      String    @default("pending") @map("status") // pending | approved | rejected
  reviewedBy  String?   @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  reviewNote  String?   @map("review_note")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, date])
  @@map("expenses")
}

// ----------------------------------------------------------- attendance ---
model AttendanceRecord {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  checkIn   DateTime? @map("check_in")
  checkOut  DateTime? @map("check_out")
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, userId, date])
  @@map("attendance_records")
}

enum LeaveStatus {
  pending
  approved
  rejected
}

model Leave {
  id          String      @id @default(cuid())
  tenantId    String      @map("tenant_id")
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDate    DateTime    @map("from_date") @db.Date
  toDate      DateTime    @map("to_date") @db.Date
  reason      String?
  status      LeaveStatus @default(pending)
  decidedById String?     @map("decided_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("leaves")
}

// ---------------------------------------------------------------- tasks ---
enum TaskStatus {
  pending
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

model Task {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  assigneeId  String?      @map("assignee_id")
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String       @map("created_by_id")
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  status      TaskStatus   @default(pending)
  priority    TaskPriority @default(medium)
  dueDate     DateTime?    @map("due_date") @db.Date
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@map("tasks")
}

// -------------------------------------------------------------- booking ---
model Booking {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId      String   @map("unit_id")
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  memberId    String?  @map("member_id")
  member      Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  title       String
  startAt     DateTime @map("start_at")
  endAt       DateTime @map("end_at")
  status      String   @default("confirmed") // confirmed | cancelled
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId, unitId, startAt])
  @@map("bookings")
}

// -------------------------------------------------------- notifications ---
enum NotificationType {
  rent_due
  contract_expiry
  task_assigned
  general
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String           @map("tenant_id")
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?          @map("user_id")
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role? // when set, targets every active user with this role in the tenant
  type      NotificationType @default(general)
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([tenantId, userId, isRead])
  @@map("notifications")
}

// ---------------------------------------------------------------- ticket ---
enum TicketStatus {
  open
  in_progress
  on_hold
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

model Ticket {
  id           String         @id @default(cuid())
  tenantId     String         @map("tenant_id")
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketNumber Int            @map("ticket_number") // sequential per tenant
  title        String
  description  String?
  category     String         @default("general") // maintenance | billing | it | housekeeping | security | general
  priority     TicketPriority @default(medium)
  status       TicketStatus   @default(open)
  memberId     String?        @map("member_id")
  member       Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  reportedById String?        @map("reported_by_id")
  reportedBy   User?          @relation("TicketReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  assignedToId String?        @map("assigned_to_id")
  assignedTo   User?          @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  unitId       String?        @map("unit_id")
  unit         Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  dueDate      DateTime?      @map("due_date") @db.Date
  resolvedAt   DateTime?      @map("resolved_at")
  closedAt     DateTime?      @map("closed_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  comments TicketComment[]

  @@unique([tenantId, ticketNumber])
  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId   String   @map("ticket_id")
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String?  @map("author_id")
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  isInternal Boolean  @default(false) @map("is_internal") // staff-only note
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

// ---------------------------------------------------------------- visitor ---
model Visitor {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  email        String?
  cnic         String?
  purpose      String    @default("meeting") // meeting | tour | interview | delivery | other
  hostMemberId String?   @map("host_member_id")
  hostMember   Member?   @relation(fields: [hostMemberId], references: [id], onDelete: SetNull)
  hostName     String?   @map("host_name") // free text if no member record
  checkInAt    DateTime  @default(now()) @map("check_in_at")
  checkOutAt   DateTime? @map("check_out_at")
  badgeNo      String?   @map("badge_no")
  notes        String?
  createdById  String?   @map("created_by_id")
  createdBy    User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, checkInAt])
  @@map("visitors")
}

// ------------------------------------------------------------ maintenance ---
enum MaintenanceStatus {
  pending
  in_progress
  completed
  cancelled
}

model MaintenanceOrder {
  id           String            @id @default(cuid())
  tenantId     String            @map("tenant_id")
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNumber  Int               @map("order_number")
  title        String
  description  String?
  category     String            @default("general") // electrical | plumbing | hvac | furniture | it | cleaning | general
  priority     TicketPriority    @default(medium)
  status       MaintenanceStatus @default(pending)
  unitId       String?           @map("unit_id")
  unit         Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  assignedToId String?           @map("assigned_to_id")
  assignedTo   User?             @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  ticketId     String?           @map("ticket_id") // linked complaint ticket
  cost         Decimal?          @db.Decimal(12, 2)
  scheduledAt  DateTime?         @map("scheduled_at")
  completedAt  DateTime?         @map("completed_at")
  createdById  String?           @map("created_by_id")
  createdBy    User?             @relation("MaintenanceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@map("maintenance_orders")
}

// ------------------------------------------------------------ inventory ---
model InventoryItem {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  sku          String?
  category     String   @default("general") // stationery | pantry | cleaning | it | furniture | general
  quantity     Int      @default(0)
  unit         String   @default("pcs") // pcs | boxes | liters | kg
  reorderLevel Int      @default(5) @map("reorder_level")
  unitPrice    Decimal? @map("unit_price") @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  movements InventoryMovement[]

  @@index([tenantId, category])
  @@map("inventory_items")
}

model InventoryMovement {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId      String        @map("item_id")
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type        String // in | out | adjustment
  quantity    Int
  note        String?
  createdById String?       @map("created_by_id")
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([itemId, createdAt])
  @@map("inventory_movements")
}

// ----------------------------------------------------------------- assets ---
enum AssetStatus {
  active
  in_repair
  retired
  lost
}

model Asset {
  id           String      @id @default(cuid())
  tenantId     String      @map("tenant_id")
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  assetTag     String?     @map("asset_tag")
  category     String      @default("general") // furniture | it | appliance | vehicle | general
  status       AssetStatus @default(active)
  unitId       String?     @map("unit_id")
  unit         Unit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  purchaseDate DateTime?   @map("purchase_date") @db.Date
  purchaseCost Decimal?    @map("purchase_cost") @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@map("assets")
}

// --------------------------------------------------------------- documents ---
model Document {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  category     String   @default("general") // contract | id | invoice | policy | other
  memberId     String?  @map("member_id")
  member       Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  fileName     String?  @map("file_name")
  fileUrl      String?  @map("file_url")
  fileSize     Int?     @map("file_size")
  mimeType     String?  @map("mime_type")
  storagePath  String?  @map("storage_path") // local disk path or S3 key
  notes        String?
  uploadedById String?  @map("uploaded_by_id")
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([tenantId, memberId])
  @@map("documents")
}

// ------------------------------------------------------------ credit notes ---
enum CreditNoteStatus {
  open
  applied
  cancelled
}

model CreditNote {
  id          String           @id @default(cuid())
  tenantId    String           @map("tenant_id")
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number      String // CN-202610-0001, unique per tenant
  memberId    String           @map("member_id")
  member      Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  invoiceId   String?          @map("invoice_id")
  invoice     Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount      Decimal          @db.Decimal(12, 2)
  amountUsed  Decimal          @default(0) @map("amount_used") @db.Decimal(12, 2)
  status      CreditNoteStatus @default(open)
  reason      String?
  createdById String?          @map("created_by_id")
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([tenantId, number])
  @@index([tenantId, memberId])
  @@map("credit_notes")
}

// ---------------------------------------------------------------- refunds ---
enum RefundStatus {
  pending
  approved
  rejected
  processed
}

model Refund {
  id            String       @id @default(cuid())
  tenantId      String       @map("tenant_id")
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number        String // RFD-202610-0001, unique per tenant
  paymentId     String?      @map("payment_id")
  payment       Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  memberId      String       @map("member_id")
  member        Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount        Decimal      @db.Decimal(12, 2)
  reason        String?
  status        RefundStatus @default(pending)
  requestedById String?      @map("requested_by_id")
  requestedBy   User?        @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  processedById String?      @map("processed_by_id")
  processedBy   User?        @relation("RefundProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  processedAt   DateTime?    @map("processed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("refunds")
}

// ------------------------------------------------------------------ rides ---
model Ride {
  id           String        @id @default(cuid())
  tenantId     String        @map("tenant_id")
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driverUserId String?       @map("driver_user_id")
  driverUser   User?         @relation(fields: [driverUserId], references: [id], onDelete: SetNull)
  driverName   String        @map("driver_name")
  from         String
  to           String
  date         DateTime      @db.Date
  time         String
  seatsTotal   Int           @map("seats_total")
  seatsLeft    Int           @map("seats_left")
  car          String?
  phone        String?
  status       String        @default("open") // open | full | cancelled
  requests     RideRequest[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([tenantId, status, date])
  @@map("rides")
}

model RideRequest {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rideId          String   @map("ride_id")
  ride            Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  requesterUserId String?  @map("requester_user_id")
  requesterUser   User?    @relation(fields: [requesterUserId], references: [id], onDelete: SetNull)
  requesterName   String   @map("requester_name")
  status          String   @default("accepted") // accepted | cancelled
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([rideId, requesterUserId])
  @@index([tenantId, rideId])
  @@map("ride_requests")
}

// ---------------------------------------------------------------- webhooks ---
model Webhook {
  id         String            @id @default(cuid())
  tenantId   String            @map("tenant_id")
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  url        String
  events     String[] // e.g. ["booking.created","payment.received"]
  secret     String? // for HMAC signature
  active     Boolean           @default(true)
  deliveries WebhookDelivery[]
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  @@index([tenantId, active])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookId    String   @map("webhook_id")
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  status       String   @default("pending") // pending | success | failed
  attempts     Int      @default(0)
  responseCode Int?     @map("response_code")
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, webhookId, createdAt])
  @@map("webhook_deliveries")
}

// ------------------------------------------------------- unit favorites ---
model UnitFavorite {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId    String   @map("unit_id")
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, unitId, userId])
  @@index([tenantId, userId])
  @@map("unit_favorites")
}

// ---------------------------------------------------------- email settings ---
model EmailSetting {
  id        String   @id @default(cuid())
  tenantId  String   @unique @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  host      String?
  port      Int      @default(587)
  secure    Boolean  @default(false)
  username  String?
  password  String? // encrypted at rest in future
  fromName  String?  @map("from_name")
  fromEmail String?  @map("from_email")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_settings")
}

// --------------------------------------------------------------- settings ---
model Setting {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@map("settings")
}

// --------------------------------------- phase 1: granular permissions ---
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "members.create"
  description String?
  module      String? // e.g. "members", "finance", "tickets"
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

// --------------------------------------------- phase 1: audit logging ---
model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?  @map("tenant_id") // null => platform-level action
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId   String?  @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String // e.g. "member.update", "invoice.create"
  entity    String // e.g. "Member"
  entityId  String?  @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// --------------------------------------- phase 1: sessions & password reset ---
model Session {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @map("refresh_hash") // hashed refresh token
  deviceInfo  String?   @map("device_info")
  ip          String?
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_resets")
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verifications")
}

// --------------------------------------- phase 22: SaaS subscriptions ------
model PlatformPlan {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  priceMonthly  Float                @map("price_monthly")
  maxUsers      Int                  @map("max_users")
  maxMembers    Int                  @map("max_members")
  maxUnits      Int                  @map("max_units")
  features      String[]
  isActive      Boolean              @default(true) @map("is_active")
  subscriptions TenantSubscription[]

  @@map("platform_plans")
}

model TenantSubscription {
  id                 String       @id @default(cuid())
  tenantId           String       @unique @map("tenant_id")
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId             String       @map("plan_id")
  plan               PlatformPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  status             String       @default("active") // active | trialing | past_due | cancelled
  trialEndsAt        DateTime?    @map("trial_ends_at")
  currentPeriodStart DateTime     @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime     @map("current_period_end")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@map("tenant_subscriptions")
}

// -------------------------------------------------------- Phase 24: API keys
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique @map("key_hash") // sha256 of the full key
  keyPrefix  String    @map("key_prefix") // first 8 chars after cwk_, for display
  scopes     String[] // e.g. ["bookings:read","members:read"] or ["*"]
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdBy  String    @map("created_by") // user id
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("api_keys")
}

// ------------------------------------------------- Phase 27: Notifications Hub
model SmsLog {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  to          String
  body        String
  status      String   @default("queued") // queued | sent | failed
  provider    String   @default("twilio") // twilio | console
  providerSid String?  @map("provider_sid")
  error       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("sms_logs")
}

model WhatsappLog {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  to          String
  template    String
  params      Json?    @map("params")
  status      String   @default("queued") // queued | sent | failed
  provider    String   @default("console") // meta | console
  providerSid String?  @map("provider_sid")
  error       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("whatsapp_logs")
}

model NotificationPreference {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String   @map("event_type") // e.g. 'booking.confirmed'
  channel   String // 'email' | 'sms' | 'whatsapp' | 'inapp'
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, eventType, channel])
  @@index([tenantId])
  @@index([userId])
  @@map("notification_preferences")
}

model Announcement {
  id        String             @id @default(cuid())
  tenantId  String             @map("tenant_id")
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  body      String             @db.Text
  audience  String             @default("all") // all | members | staff
  channels  String[]           @default(["inapp"]) // inapp | email | sms | whatsapp
  sentBy    String             @map("sent_by")
  sender    User               @relation("SentAnnouncements", fields: [sentBy], references: [id], onDelete: Cascade)
  sentAt    DateTime?          @map("sent_at")
  createdAt DateTime           @default(now()) @map("created_at")
  pinned    Boolean            @default(false) @map("pinned")
  expiresAt DateTime?          @map("expires_at")
  reads     AnnouncementRead[]

  @@index([tenantId])
  @@map("announcements")
}

// ------------------------------------------------- Phase 28: Job Queue
model Job {
  id          String   @id @default(cuid())
  tenantId    String?  @map("tenant_id")
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String // email | webhook | sms | whatsapp | report
  payload     Json
  status      String   @default("pending") // pending | processing | completed | failed
  attempts    Int      @default(0)
  maxAttempts Int      @default(5) @map("max_attempts")
  runAt       DateTime @default(now()) @map("run_at")
  lastError   String?  @map("last_error") @db.Text
  retryDelays Json?    @map("retry_delays") // phase 32: optional custom retry schedule (ms array)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@index([tenantId])
  @@map("jobs")
}

// ------------------------------------------------- Phase 29: Growth Pack
model RecurringBooking {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId     String?   @map("member_id")
  member       Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  unitId       String    @map("unit_id")
  unit         Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title        String
  dayOfWeek    Int       @map("day_of_week") // 0=Sunday .. 6=Saturday
  startTime    String    @map("start_time") // "HH:mm"
  endTime      String    @map("end_time") // "HH:mm"
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  status       String    @default("active") // active | paused | cancelled
  generatedIds String[]  @default([]) @map("generated_ids")
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("recurring_bookings")
}

model Lead {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  email             String?
  phone             String?
  company           String?
  source            String   @default("walkin") // walkin | website | referral | social | other
  interest          String?
  budget            Decimal? @db.Decimal(12, 2)
  stage             String   @default("new") // new | contacted | visit | booked | lost
  notes             String?  @db.Text
  assignedTo        String?  @map("assigned_to")
  assignee          User?    @relation("LeadAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  convertedMemberId String?  @map("converted_member_id")
  convertedMember   Member?  @relation("LeadConversion", fields: [convertedMemberId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([tenantId, stage])
  @@map("leads")
}

model Feedback {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId   String   @map("member_id")
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  category   String   @default("other") // facility | service | staff | cleanliness | other
  rating     Int      @default(5) // 1..5
  message    String   @db.Text
  status     String   @default("new") // new | reviewed | resolved
  adminReply String?  @map("admin_reply") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([memberId])
  @@map("feedback")
}

// ------------------------------------------------- Phase 30: Polish Pack
model EmailTemplate {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String // e.g. 'bookingConfirmed' — matches mailer's notify() template names
  subject   String
  htmlBody  String   @map("html_body") @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("email_templates")
}

model SavedView {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  page      String // e.g. 'members', 'bookings'
  name      String
  filters   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, page, name])
  @@index([tenantId])
  @@index([userId, page])
  @@map("saved_views")
}

model BookingRequest {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String
  unitId    String   @map("unit_id")
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  startTime String   @map("start_time") // "HH:mm"
  endTime   String   @map("end_time") // "HH:mm"
  notes     String?  @db.Text
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@map("booking_requests")
}

// ------------------------------------------------ Phase 31: Finance Pro ---
model SalaryStructure {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String   @map("user_id")
  user          User     @relation("SalaryStructures", fields: [userId], references: [id], onDelete: Cascade)
  basicSalary   Decimal  @map("basic_salary") @db.Decimal(12, 2)
  allowances    Json     @default("{}")
  deductions    Json     @default("{}")
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([userId, effectiveFrom])
  @@index([tenantId])
  @@map("salary_structures")
}

model PayrollRun {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  month       String
  status      String    @default("draft")
  totalAmount Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  createdBy   String?   @map("created_by")
  finalizedAt DateTime? @map("finalized_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  payslips Payslip[]

  @@unique([tenantId, month])
  @@index([tenantId])
  @@map("payroll_runs")
}

model Payslip {
  id              String     @id @default(cuid())
  payrollRunId    String     @map("payroll_run_id")
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  userId          String     @map("user_id")
  user            User       @relation("Payslips", fields: [userId], references: [id], onDelete: Cascade)
  grossSalary     Decimal    @map("gross_salary") @db.Decimal(12, 2)
  totalDeductions Decimal    @map("total_deductions") @db.Decimal(12, 2)
  netPay          Decimal    @map("net_pay") @db.Decimal(12, 2)
  details         Json       @default("{}")
  status          String     @default("pending")
  createdAt       DateTime   @default(now()) @map("created_at")

  @@index([payrollRunId])
  @@index([userId])
  @@map("payslips")
}

model RecurringInvoice {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId        String    @map("member_id")
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title           String
  amount          Decimal   @db.Decimal(12, 2)
  frequency       String    @default("monthly")
  dayOfMonth      Int       @map("day_of_month")
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  status          String    @default("active")
  lastGeneratedAt DateTime? @map("last_generated_at")
  nextRunAt       DateTime  @map("next_run_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([nextRunAt])
  @@map("recurring_invoices")
}

model DunningLog {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId String   @map("invoice_id")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  level     Int
  channel   String   @default("email")
  sentAt    DateTime @default(now()) @map("sent_at")
  error     String?

  @@unique([invoiceId, level])
  @@index([tenantId])
  @@index([invoiceId])
  @@map("dunning_logs")
}

model OnlinePayment {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId  String   @map("invoice_id")
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  gateway    String
  amount     Decimal  @db.Decimal(12, 2)
  status     String   @default("pending")
  gatewayRef String?  @map("gateway_ref")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([invoiceId])
  @@map("online_payments")
}

model Budget {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  month     String
  category  String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, month, category])
  @@index([tenantId, month])
  @@map("budgets")
}

model PettyCashTransaction {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  category    String?
  performedBy String   @map("performed_by")
  performer   User     @relation(fields: [performedBy], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("petty_cash_transactions")
}

// ------------------------------------------------- Phase 32: Security Pack
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") // id of successor token (rotation chain)
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  deviceName   String?   @map("device_name")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model LoginAlert {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress      String    @map("ip_address")
  userAgent      String?   @map("user_agent") @db.Text
  type           String    @default("new_device") // new_device | suspicious | blocked_ip
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, userId])
  @@index([tenantId, ipAddress])
  @@map("login_alerts")
}

model AuditArchive {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodFrom  DateTime @map("period_from")
  periodTo    DateTime @map("period_to")
  recordCount Int      @map("record_count")
  filePath    String?  @map("file_path")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("audit_archives")
}

model BackupRecord {
  id        String   @id @default(cuid())
  tenantId  String?  @map("tenant_id") // null = system-level backup (super_admin)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName  String   @map("file_name")
  filePath  String   @map("file_path") @db.Text
  sizeBytes BigInt   @map("size_bytes")
  status    String   @default("completed") // completed | failed
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("backup_records")
}

// ------------------------------------------------- Phase 33: Community & Engagement
model CommunityEvent {
  id             String      @id @default(cuid())
  tenantId       String      @map("tenant_id")
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  description    String?     @db.Text
  startsAt       DateTime    @map("starts_at")
  endsAt         DateTime    @map("ends_at")
  location       String?
  capacity       Int?
  imageUrl       String?     @map("image_url")
  status         String      @default("upcoming") // upcoming | ongoing | completed | cancelled
  reminderSentAt DateTime?   @map("reminder_sent_at")
  createdBy      String?     @map("created_by")
  creator        User?       @relation("EventCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  rsvps          EventRsvp[]
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, startsAt])
  @@map("community_events")
}

model EventRsvp {
  id        String         @id @default(cuid())
  eventId   String         @map("event_id")
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId  String         @map("member_id")
  member    Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    String         @default("going") // going | interested | cancelled
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([eventId, memberId])
  @@index([eventId])
  @@map("event_rsvps")
}

model ReferralCode {
  id        String     @id @default(cuid())
  tenantId  String     @map("tenant_id")
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId  String     @map("member_id")
  member    Member     @relation("MemberReferralCodes", fields: [memberId], references: [id], onDelete: Cascade)
  code      String // e.g. REF-7K2Q9X (unique globally)
  referrals Referral[] @relation("CodeReferrals")
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([code])
  @@unique([tenantId, memberId])
  @@index([tenantId])
  @@map("referral_codes")
}

model Referral {
  id            String       @id @default(cuid())
  tenantId      String       @map("tenant_id")
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  codeId        String       @map("code_id")
  code          ReferralCode @relation("CodeReferrals", fields: [codeId], references: [id], onDelete: Cascade)
  referredName  String       @map("referred_name")
  referredEmail String       @map("referred_email")
  status        String       @default("invited") // invited | joined | rewarded
  rewardAmount  Decimal?     @map("reward_amount") @db.Decimal(12, 2)
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@index([codeId])
  @@map("referrals")
}

model LoyaltyLedger {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId  String   @map("member_id")
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  points    Int // positive = earned, negative = redeemed
  reason    String // invoice_payment | referral_bonus | manual_adjust | redeemed | welcome
  relatedId String?  @map("related_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([memberId])
  @@map("loyalty_ledger")
}

model MarketplaceListing {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId    String    @map("member_id")
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  category    String    @default("service") // service | product | job
  price       Decimal?  @db.Decimal(12, 2)
  contactInfo String?   @map("contact_info")
  status      String    @default("active") // active | pending | sold | expired
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, category])
  @@map("marketplace_listings")
}

model Survey {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  type      String   @default("nps") // nps | custom
  status    String   @default("draft") // draft | active | closed
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  responses SurveyResponse[]
  invites   SurveyInvite[]

  @@index([tenantId, status])
  @@map("surveys")
}

model SurveyResponse {
  id        String   @id @default(cuid())
  surveyId  String   @map("survey_id")
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  memberId  String?  @map("member_id")
  member    Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  score     Int? // 0..10 (NPS)
  answers   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([surveyId, memberId])
  @@index([surveyId])
  @@map("survey_responses")
}

model SurveyInvite {
  id       String   @id @default(cuid())
  surveyId String   @map("survey_id")
  survey   Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  memberId String   @map("member_id")
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sentAt   DateTime @default(now()) @map("sent_at")

  @@unique([surveyId, memberId])
  @@index([surveyId])
  @@map("survey_invites")
}

model VisitorInvite {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId     String   @map("member_id") // host member
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  visitorName  String   @map("visitor_name")
  visitorEmail String?  @map("visitor_email")
  visitorPhone String?  @map("visitor_phone")
  expectedAt   DateTime @map("expected_at")
  purpose      String   @default("meeting") // meeting | tour | interview | delivery | other
  notes        String?
  code         String   @db.Char(6) // 6-char check-in code, unique per tenant
  status       String   @default("pending") // pending | checked-in | expired | cancelled
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@index([tenantId, status, expectedAt])
  @@map("visitor_invites")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  keys      Json // { p256dh, auth } — Web Push subscription keys
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String       @map("announcement_id")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation("AnnouncementReads", fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now()) @map("read_at")

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
  @@map("announcement_reads")
}
