  payrollRunId    String     @map("payroll_run_id")
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  userId          String     @map("user_id")
  user            User       @relation("Payslips", fields: [userId], references: [id], onDelete: Cascade)
  grossSalary     Decimal    @map("gross_salary") @db.Decimal(12, 2)
  totalDeductions Decimal    @map("total_deductions") @db.Decimal(12, 2)
  netPay          Decimal    @map("net_pay") @db.Decimal(12, 2)
  details         Json       @default("{}")
  status          String     @default("pending")
  createdAt       DateTime   @default(now()) @map("created_at")

  @@index([payrollRunId])
  @@index([userId])
  @@map("payslips")
}

model RecurringInvoice {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId        String    @map("member_id")
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title           String
  amount          Decimal   @db.Decimal(12, 2)
  frequency       String    @default("monthly")
  dayOfMonth      Int       @map("day_of_month")
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  status          String    @default("active")
  lastGeneratedAt DateTime? @map("last_generated_at")
  nextRunAt       DateTime  @map("next_run_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([nextRunAt])
  @@map("recurring_invoices")
}

model DunningLog {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId String   @map("invoice_id")
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  level     Int
  channel   String   @default("email")
  sentAt    DateTime @default(now()) @map("sent_at")
  error     String?

  @@unique([invoiceId, level])
  @@index([tenantId])
  @@index([invoiceId])
  @@map("dunning_logs")
}

model OnlinePayment {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId  String   @map("invoice_id")
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  gateway    String
  amount     Decimal  @db.Decimal(12, 2)
  status     String   @default("pending")
  gatewayRef String?  @map("gateway_ref")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([invoiceId])
  @@map("online_payments")
}

model Budget {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  month     String
  category  String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, month, category])
  @@index([tenantId, month])
  @@map("budgets")
}

model PettyCashTransaction {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  category    String?
  performedBy String   @map("performed_by")
  performer   User     @relation(fields: [performedBy], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("petty_cash_transactions")
}

// ------------------------------------------------- Phase 32: Security Pack
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") // id of successor token (rotation chain)
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  deviceName   String?   @map("device_name")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model LoginAlert {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress      String    @map("ip_address")
  userAgent      String?   @map("user_agent") @db.Text
  type           String    @default("new_device") // new_device | suspicious | blocked_ip
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, userId])
  @@index([tenantId, ipAddress])
  @@map("login_alerts")
}

model AuditArchive {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodFrom  DateTime @map("period_from")
  periodTo    DateTime @map("period_to")
  recordCount Int      @map("record_count")
  filePath    String?  @map("file_path")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("audit_archives")
}

model BackupRecord {
  id        String   @id @default(cuid())
  tenantId  String?  @map("tenant_id") // null = system-level backup (super_admin)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName  String   @map("file_name")
  filePath  String   @map("file_path") @db.Text
  sizeBytes BigInt   @map("size_bytes")
  status    String   @default("completed") // completed | failed
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("backup_records")
}

// ------------------------------------------------- Phase 33: Community & Engagement
model CommunityEvent {
  id             String      @id @default(cuid())
  tenantId       String      @map("tenant_id")
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  description    String?     @db.Text
  startsAt       DateTime    @map("starts_at")
  endsAt         DateTime    @map("ends_at")
  location       String?
  capacity       Int?
  imageUrl       String?     @map("image_url")
  status         String      @default("upcoming") // upcoming | ongoing | completed | cancelled
  reminderSentAt DateTime?   @map("reminder_sent_at")
  createdBy      String?     @map("created_by")
  creator        User?       @relation("EventCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  rsvps          EventRsvp[]
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, startsAt])
  @@map("community_events")
  checkins    EventCheckin[]
  // Phase 44: public ticketing
  isPublic    Boolean   @default(false) @map("is_public")
  slug        String?   @map("slug")
  externalUrl String?   @map("external_url")
  ticketTypes TicketType[]
  tickets     EventTicket[]
  sponsors    EventSponsor[]
  speakers    EventSpeaker[]
  sessions    EventSession[]

  @@unique([tenantId, slug])
}

model EventRsvp {
  id        String         @id @default(cuid())
  eventId   String         @map("event_id")
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId  String         @map("member_id")
  member    Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    String         @default("going") // going | interested | cancelled
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([eventId, memberId])
  @@index([eventId])
  @@map("event_rsvps")
}

// ----------------------------------------------------------------- Phase 44: Events & Ticketing Pro Pack
model TicketType {
  id            String         @id @default(cuid())
  tenantId      String         @map("tenant_id")
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId       String         @map("event_id")
  event         CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String // Early Bird | Regular | VIP | ...
  price         Decimal        @db.Decimal(12, 2)
  quantity      Int            // total tickets iss type ke
  soldCount     Int            @default(0) @map("sold_count")
  saleStart     DateTime?      @map("sale_start")
  saleEnd       DateTime?      @map("sale_end")
  isActive      Boolean        @default(true) @map("is_active")
  perOrderLimit Int?           @map("per_order_limit") // ek order me max kitne
  tickets       EventTicket[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([tenantId, eventId])
  @@index([eventId, isActive])
  @@map("ticket_types")
}

model EventTicket {
  id           String         @id @default(cuid())
  tenantId     String         @map("tenant_id")
  eventId      String         @map("event_id")
  ticketTypeId String         @map("ticket_type_id")
  buyerName    String         @map("buyer_name")
  buyerEmail   String         @map("buyer_email")
  buyerPhone   String?        @map("buyer_phone")
  memberId     String?        @map("member_id") // optional link agar buyer member ho
  code         String         @unique // HMAC-signed QR token (member-qr pattern)
  status       String         @default("valid") @map("status") // valid | used | refunded | transferred | payment_pending
  price        Decimal        @db.Decimal(12, 2)
  purchasedAt  DateTime       @default(now()) @map("purchased_at")
  usedAt       DateTime?      @map("used_at")
  refundReason String?        @map("refund_reason")
  refundedAt   DateTime?      @map("refunded_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event      CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType     @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  member     Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  transfers  TicketTransfer[]

  @@index([tenantId, eventId])
  @@index([tenantId, buyerEmail])
  @@index([ticketTypeId, status])
  @@map("event_tickets")
}

model TicketTransfer {
  id            String       @id @default(cuid())
  tenantId      String       @map("tenant_id")
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId      String       @map("ticket_id") // purana (invalidate hua) ticket
  ticket        EventTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromEmail     String       @map("from_email")
  toName        String       @map("to_name")
  toEmail       String       @map("to_email")
  transferredAt DateTime     @default(now()) @map("transferred_at")

  @@index([tenantId, ticketId])
  @@index([toEmail])
  @@map("ticket_transfers")
}

model EventSponsor {
  id        String         @id @default(cuid())
  tenantId  String         @map("tenant_id")
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId   String         @map("event_id")
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  tier      String         @default("silver") // platinum | gold | silver
  logoUrl   String?        @map("logo_url")
  website   String?
  amount    Decimal?       @db.Decimal(12, 2)
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([eventId])
  @@map("event_sponsors")
}

model EventSpeaker {
  id        String         @id @default(cuid())
  tenantId  String         @map("tenant_id")
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId   String         @map("event_id")
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  title     String?
  company   String?
  bio       String?        @db.Text
  photoUrl  String?        @map("photo_url")
  sessions  EventSession[]
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([eventId])
  @@map("event_speakers")
}

model EventSession {
  id          String         @id @default(cuid())
  tenantId    String         @map("tenant_id")
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId     String         @map("event_id")
  event       CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  description String?        @db.Text
  speakerId   String?        @map("speaker_id")
  speaker     EventSpeaker?  @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  startTime   DateTime       @map("start_time")
  endTime     DateTime       @map("end_time")
  location    String?
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([eventId])
  @@map("event_sessions")
}
// ----------------------------------------------------------------- end Phase 44

model ReferralCode {
  id        String     @id @default(cuid())
  tenantId  String     @map("tenant_id")
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId  String     @map("member_id")
  member    Member     @relation("MemberReferralCodes", fields: [memberId], references: [id], onDelete: Cascade)
  code      String // e.g. REF-7K2Q9X (unique globally)
  referrals Referral[] @relation("CodeReferrals")
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([code])
  @@unique([tenantId, memberId])
  @@index([tenantId])
  @@map("referral_codes")
}

model Referral {
  id            String       @id @default(cuid())
  tenantId      String       @map("tenant_id")
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  codeId        String       @map("code_id")
  code          ReferralCode @relation("CodeReferrals", fields: [codeId], references: [id], onDelete: Cascade)
  referredName  String       @map("referred_name")
  referredEmail String       @map("referred_email")
  status        String       @default("invited") // invited | joined | rewarded
  rewardAmount  Decimal?     @map("reward_amount") @db.Decimal(12, 2)
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@index([codeId])
  @@map("referrals")
}

model LoyaltyLedger {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId  String   @map("member_id")
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  points    Int // positive = earned, negative = redeemed
  reason    String // invoice_payment | referral_bonus | manual_adjust | redeemed | welcome
  relatedId String?  @map("related_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([memberId])
  @@map("loyalty_ledger")
}

model MarketplaceListing {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId    String    @map("member_id")
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  category    String    @default("service") // service | product | job
  price       Decimal?  @db.Decimal(12, 2)
  contactInfo String?   @map("contact_info")
  status      String    @default("active") // active | pending | sold | expired
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, category])
  @@map("marketplace_listings")
}

model Survey {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  type      String   @default("nps") // nps | custom
  status    String   @default("draft") // draft | active | closed
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  responses SurveyResponse[]
  invites   SurveyInvite[]

  @@index([tenantId, status])
  @@map("surveys")
}

model SurveyResponse {
  id        String   @id @default(cuid())
  surveyId  String   @map("survey_id")
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  memberId  String?  @map("member_id")
  member    Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  score     Int? // 0..10 (NPS)
  answers   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([surveyId, memberId])
  @@index([surveyId])
  @@map("survey_responses")
}

model SurveyInvite {
  id       String   @id @default(cuid())
  surveyId String   @map("survey_id")
  survey   Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  memberId String   @map("member_id")
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sentAt   DateTime @default(now()) @map("sent_at")

  @@unique([surveyId, memberId])
  @@index([surveyId])
  @@map("survey_invites")
}

model VisitorInvite {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId     String   @map("member_id") // host member
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  visitorName  String   @map("visitor_name")
  visitorEmail String?  @map("visitor_email")
  visitorPhone String?  @map("visitor_phone")
  expectedAt   DateTime @map("expected_at")
  purpose      String   @default("meeting") // meeting | tour | interview | delivery | other
  notes        String?
  code         String   @db.Char(6) // 6-char check-in code, unique per tenant
  status       String   @default("pending") // pending | checked-in | expired | cancelled
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@index([tenantId, status, expectedAt])
  @@map("visitor_invites")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  keys      Json // { p256dh, auth } — Web Push subscription keys
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String       @map("announcement_id")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation("AnnouncementReads", fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now()) @map("read_at")

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@index([userId])
  @@map("announcement_reads")
}

// ------------------------------------------------- Phase 34: shifts ---
model Shift {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String    @map("user_id")
  user           User      @relation("ShiftUser", fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime  @map("date")
  startTime      String    @map("start_time")
  endTime        String    @map("end_time")
  role           String?
  notes          String?   @db.Text
  reminderSentAt DateTime? @map("reminder_sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@index([tenantId, date])
  @@map("shifts")
}

model ShiftTemplate {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation("ShiftTemplateUser", fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int      @map("day_of_week")
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  role      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId, dayOfWeek])
  @@index([tenantId])
  @@map("shift_templates")
}

// ------------------------------------------ Phase 34: facility assets ---
// NOTE: `Asset` (inventory) already exists — this is the checkout-based one.
model FacilityAsset {
  id           String                  @id @default(cuid())
  tenantId     String                  @map("tenant_id")
  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  category     String
  serialNumber String?                 @map("serial_number")
  purchaseDate DateTime?               @map("purchase_date")
  value        Decimal?                @db.Decimal(12, 2)
  status       String                  @default("available")
  location     String?
  checkouts    FacilityAssetCheckout[]
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, category])
  @@map("facility_assets")
}

model FacilityAssetCheckout {
  id           String        @id @default(cuid())
  assetId      String        @map("asset_id")
  asset        FacilityAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tenantId     String        @map("tenant_id")
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId     String?       @map("member_id")
  member       Member?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  userId       String?       @map("user_id")
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  checkedOutAt DateTime      @default(now()) @map("checked_out_at")
  dueAt        DateTime?     @map("due_at")
  returnedAt   DateTime?     @map("returned_at")
  condition    String?
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([tenantId, returnedAt])
